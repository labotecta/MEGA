Modelo estándar ampliado
C o m p i l a t i o n


   2   
      basado en el libro:
      Handbook of Computible General Equilibrium Modeling
      Hosoe, N, Gasawa, K, and Hashimoto, H
      University of Tokyo Press, Tokyo, Japan, 2004
   9   
  10  Set
  11     u      'SAM entry'  / BRD,MLK,CAP,LAB,IDT,TRF,HOH1,HOH2,GOV,CSS,INV,EXT /
  12     i(u)   'goods'      / BRD,MLK                                           /
  13     h(u)   'factor'     /         CAP,LAB                                   /
  14     l(u)   'demanda'    /                         HOH1,HOH2                 /;
  15   
  16  Alias (u,v), (i,j), (h,k), (l,n);
  17  Parameter SAM(u,v);
  18   
  30   
  31  display SAM;
  32   
  33  * Loading the initial values
  34  Parameter
  35     Y0(j)     'composite factor'
  36     F0(h,j)   'the h-th factor input by the j-th firm'
  37     X0(i,j)   'intermediate input'
  38     Z0(j)     'output of the j-th good'
  39     Xp0(l,i)  'household consumption of the i-th good '
  40     Xg0(i)    'government consumption'
  41     Xv0(i)    'investment demand'
  42     E0(i)     'exports'
  43     M0(i)     'imports'
  44     Q0(i)     "Armington's composite good"
  45     tauz(i)   'production tax rate'
  46     D0(i)     'domestic good'
  47     Sp0(l)    'private saving'
  48     Sg0       'government saving'
  49     Td0(l)    'direct tax'
  50     Tz0(j)    'production tax'
  51     Tm0(j)    'import tariff'
  52     FF(l,h)   'factor endowment of the h-th factor'
  53     Sf        'foreign saving in US dollars'
  54     CssH0(l)  'pagos a la seguridad social de los hogares'
  55     CssE0(i)  'pagos a la seguridad social de las empresas'
  56     pWe(i)    'export price in US dollars'
  57     pWm(i)    'import price in US dollars'
  58  ;
  59  Td0(l)    = SAM("GOV",l);
  60  Tz0(j)    = SAM("IDT",j);
  61  Tm0(j)    = SAM("TRF",j);
  62  F0(h,j)   = SAM(h,j);
  63  Y0(j)     = sum(h, F0(h,j));
  64  X0(i,j)   = SAM(i,j);
  65  Z0(j)     = Y0(j)+sum(i,X0(i,j));
  66  M0(i)     = SAM("EXT",i);
  67  CssE0(i)  = SAM("CSS",i);
  68  CssH0(l)  = SAM("CSS",l);
  69  Xp0(l,i)  = SAM(i,l);
  70  FF(l,h)   = SAM(l,h);
  71  Xg0(i)    = SAM(i,"GOV");
  72  Xv0(i)    = SAM(i,"INV");
  73  E0(i)     = SAM(i,"EXT");
  74  Q0(i)     = sum(l, Xp0(l,i))+Xg0(i)+Xv0(i)+sum(j,X0(i,j));
  75  tauz(j)   = Tz0(j)/Z0(j);
  76  D0(i)     = (1+tauz(i))*Z0(i)-E0(i)+CssE0(i);
  77  Sp0(l)    = SAM("INV",l);
  78  Sg0       = SAM("INV","GOV");
  79  Sf        = SAM("INV","EXT");
  80  pWe(i)    = 1.;
  81  pWm(i)    = 1.;
  82   
  83  display FF,F0,Y0,X0,Xp0,Xg0,Xv0,Q0,Z0,E0,M0,D0,Td0,Tz0,Tm0,Sp0,Sg0,Sf,
  84          CssE0,CssH0;
  85   
  86  * Calibration
  87  Parameter
  88     sigma(i) 'elasticity of substitution'
  89     psi(i)   'elasticity of transformation'
  90     eta(i)   'substitution elasticity parameter'
  91     phi(i)   'transformation elasticity parameter';
  92   
  93  sigma(i) =  2;
  94  psi(i)   =  2;
  95  eta(i)   = (sigma(i) - 1)/sigma(i);
  96  phi(i)   = (psi(i) + 1)/psi(i);
  97   
  98  Parameter
  99     alpha(l,i) 'share parameter in utility func.'
 100     beta(h,j)  'share parameter in production func.'
 101     b(j)       'scale parameter in production func.'
 102     ax(i,j)    'intermediate input requirement coeff.'
 103     ay(j)      'composite fact. input req. coeff.'
 104     mu(i)      'government consumption share'
 105     lambda(i)  'investment demand share'
 106     deltam(i)  'share par. in Armington func.'
 107     deltad(i)  'share par. in Armington func.'
 108     gamma(i)   'scale par. in Armington func.'
 109     xid(i)     'share par. in transformation func.'
 110     xie(i)     'share par. in transformation func.'
 111     theta(i)   'scale par. in transformation func.'
 112     ssp(l)     'average propensity for private saving'
 113     ssg        'average propensity for gov. saving'
 114     taud(l)    'direct tax rate'
 115     taum(i)    'import tariff rate'
 116     ctzsse(i)  'tipo seg.social empresas'
 117     ctzssh(l)  'tipo seg.social hogares';
 118   
 119  alpha(l,i)  =  Xp0(l,i)/sum(j, Xp0(l,j));
 120  beta(h,j)   =  F0(h,j)/sum(k, F0(k,j));
 121  b(j)        =  Y0(j)/prod(h, F0(h,j)**beta(h,j));
 122  ax(i,j)     =  X0(i,j)/Z0(j);
 123  ay(j)       =  Y0(j)/Z0(j);
 124  mu(i)       =  Xg0(i)/sum(j, Xg0(j));
 125  lambda(i)   =  Xv0(i)/(sum(l,Sp0(l))+Sg0+Sf);
 126  taum(j)     =  Tm0(j)/M0(j);
 127  deltam(i)   = (1+taum(i))*M0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 128  deltad(i)   =  D0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 129  gamma(i)    =  Q0(i)/(deltam(i)*M0(i)**eta(i)+deltad(i)*D0(i)**eta(i))**(1/eta(i));
 130  xie(i)      =  E0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 131  xid(i)      =  D0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 132  theta(i)    =  Z0(i)/(xie(i)*E0(i)**phi(i)+xid(i)*D0(i)**phi(i))**(1/phi(i));
 133  ssp(l)      =  Sp0(l)/(sum(h, FF(l,h)));
 134  ssg         =  Sg0/(sum(l,Td0(l))+sum(j,Tz0(j))+sum(j,Tm0(j)));
 135  taud(l)     =  Td0(l)/(sum(h, FF(l,h)));
 136  taum(j)     =  Tm0(j)/M0(j);
 137  ctzsse(i)   =  CssE0(i)/F0("LAB",i);
 138  ctzssh(l)   =  CssH0(l)/(FF(l,"LAB"));
 139   
 140  display phi,tauz,taum,alpha,beta,b,ax,ay,mu,lambda,deltam,deltad,gamma,xie,xid,
 141          theta,ssp,ssg,taud,ctzsse,ctzssh;
 142   
 143  Variable
 144     pf(h)    'the h-th factor price'
 145     py(j)    'composite factor price'
 146     pz(j)    'supply price of the i-th good'
 147     pq(i)    "Armington's composite good price"
 148     pd(i)    'the i-th domestic good price'
 149     epsilon  'exchange rate'
 150     pe(i)    'export price in local currency'
 151     pm(i)    'import price in local currency'
 152     Y(j)     'composite factor'
 153     F(h,j)   'the h-th factor input by the j-th firm'
 154     X(i,j)   'intermediate input'
 155     Td(l)    'direct tax'
 156     Tz(j)    'production tax'
 157     Tm(i)    'import tariff'
 158     Sp(l)    'private saving'
 159     Sg       'government saving'
 160     Xg(i)    'government consumption'
 161     CssH(l)  'pagos a la seguridad social de los hogares'
 162     CssE(i)  'pagos a la seguridad social de las empresas'
 163     Xv(i)    'investment demand'
 164     Xp(l,i)  'household consumption of the i-th good'
 165     Q(i)     "Armington's composite good"
 166     M(i)     'imports'
 167     D(i)     'domestic good'
 168     Z(j)     'output of the j-th good'
 169     E(i)     'exports'
 170     UU       'utility [fictitious]';
 171   
 172  Equation
 173     eqepsilon   'balance of payments'
 174     eqpe(i)     'world export price equation'
 175     eqpm(i)     'world import price equation'
 176     eqpy(j)     'composite factor agg. func.'
 177     eqF(h,j)    'factor demand function'
 178     eqX(i,j)    'intermediate demand function'
 179     eqY(j)      'composite factor demand function'
 180     eqpzs(j)    'unit cost function'
 181     eqTd(l)     'direct tax revenue function'
 182     eqTz(j)     'production tax revenue function'
 183     eqTm(i)     'import tariff revenue function'
 184     eqSp(l)     'private saving function'
 185     eqSg        'government saving function'
 186     eqXg(i)     'government demand function'
 187     eqctzsse(i) 'cotización seg social empresas'
 188     eqctzssh(l) 'cotización seg social hogares'
 189     eqXv(i)     'investment demand function'
 190     eqXp(l,i)   'household demand function'
 191     eqpqs(i)    'Armington function'
 192     eqM(i)      'import demand function'
 193     eqD(i)      'domestic good demand function'
 194     eqpzd(i)    'transformation function'
 195     eqDs(i)     'domestic good supply function'
 196     eqE(i)      'export supply function'
 197     eqpqd(i)    'market clearing cond. for comp. good'
 198     eqpf(h)     'factor market clearing condition'
 199     obj         'utility function [fictitious]';
 200   
 201  * domestic production
 202  eqpe(i)..     pe(i)   =e= epsilon*pWe(i);
 203   
 204  eqpm(i)..     pm(i)   =e= epsilon*pWm(i);
 205   
 206  eqpy(j)..     Y(j)    =e= b(j)*prod(h, F(h,j)**beta(h,j));
 207   
 208  eqF(h,j)..    F(h,j)  =e= beta(h,j)*py(j)*Y(j)/pf(h);
 209   
 210  eqX(i,j)..    X(i,j)  =e= ax(i,j)*Z(j);
 211   
 212  eqY(j)..      Y(j)    =e= ay(j)*Z(j);
 213   
 214  eqpzs(j)..    pz(j)   =e= ay(j)*py(j)+sum(i,ax(i,j)*pq(i));
 215   
 216  * government behavior
 217  eqTd(l)..     Td(l)   =e= taud(l) * (sum(h,pf(h)*FF(l,h)));
 218   
 219  eqTz(j)..     Tz(j)   =e= tauz(j)*pz(j)*Z(j);
 220   
 221  eqTm(i)..     Tm(i)   =e= taum(i)*pm(i)*M(i);
 222   
 223  eqSp(l)..     Sp(l)   =e= ssp(l) * (sum(h, pf(h)*FF(l,h)));
 224   
 225  eqSg..        Sg      =e= ssg*(sum(l,Td(l))+sum(j, Tz(j))+sum(j,Tm(j))+sum(j,CssE(j))+sum(l,CssH(l)));
 226   
 227  eqXg(i)..     Xg(i)   =e= mu(i)*(sum(l,Td(l))+sum(j,Tz(j))+sum(j,Tm(j))+sum(j,CssE(j))+sum(l,CssH(l))-Sg)/pq(i);
 228   
 229  eqctzsse(i).. CssE(i) =e= ctzsse(i) * F('LAB',i);
 230   
 231  eqctzssh(l).. CssH(l) =e= ctzssh(l) * (FF[l,'LAB']);
 232   
 233  * investment behavior
 234  eqXv(i)..     Xv(i)   =e= lambda(i)*(sum(l,Sp(l))+Sg+epsilon*Sf)/pq(i);
 235   
 236  * savings
 237   
 238  * household consumption
 239  eqXp(l,i)..   Xp(l,i) =e= alpha(l,i) * (sum(h,pf(h)*FF(l,h))-(Sp(l)+Td(l)+CssH(l)))/pq(i);
 240   
 241  * international trade
 242  eqepsilon.. sum(i,pWe(i)*E(i))+Sf =e= sum(i,pWm(i)*M(i));
 243   
 244  * Armington function
 245  eqpqs(i)..  Q(i)      =e=  gamma(i)*(deltam(i)*M(i)**eta(i) + deltad(i)*D(i)**eta(i))**(1/eta(i));
 246   
 247  eqM(i)..    M(i)      =e= (gamma(i)**eta(i)*deltam(i)*pq(i)/((1+taum(i))*pm(i)))**(1/(1-eta(i)))*Q(i);
 248   
 249  eqD(i)..    D(i)      =e= (gamma(i)**eta(i)*deltad(i)*pq(i)/pd(i))**(1/(1-eta(i)))*Q(i);
 250   
 251  * transformation function
 252  eqpzd(i)..  Z(i)      =e=  theta(i)*(xie(i)*E(i)**phi(i)+xid(i)*D(i)**phi(i))**(1/phi(i));
 253   
 254  eqE(i)..    E(i)      =e= (theta(i)**phi(i)*xie(i)*(1+tauz(i)+CssE(i)/Z(i))**(1/(1-phi(i)))*Z(i));
 255   
 256  eqDs(i)..   D(i)      =e= (theta(i)**phi(i)*xid(i)*(1+tauz(i)+CssE(i)/Z(i))**(1/(1-phi(i)))*Z(i));
 257   
 258  * market clearing condition
 259  eqpqd(i)..  Q(i)      =e= sum(l, Xp(l,i)) + Xg(i) + Xv(i) + sum(j, X(i,j));
 260   
 261  eqpf(h)..   sum(j, F(h,j)) =e= sum(l,FF(l,h));
 262  * fictitious objective function
 263  obj..       UU        =e= sum(l, prod(i, Xp(l,i)**alpha(l,i)));
 264   
 265  * Initializing variables
 266  pf.l(h)   = 1.;
 267  py.l(j)   = 1.;
 268  pz.l(j)   = 1.;
 269  pq.l(i)   = 1.;
 270  pe.l(i)   = 1.;
 271  pm.l(i)   = 1.;
 272  pd.l(i)   = 1.;
 273  epsilon.l = 1.;
 274  Y.l(j)    = Y0(j);
 275  F.l(h,j)  = F0(h,j);
 276  X.l(i,j)  = X0(i,j);
 277  Z.l(j)    = Z0(j);
 278  Xp.l(l,i) = Xp0(l,i);
 279  Xg.l(i)   = Xg0(i);
 280  Xv.l(i)   = Xv0(i);
 281  E.l(i)    = E0(i);
 282  M.l(i)    = M0(i);
 283  Q.l(i)    = Q0(i);
 284  D.l(i)    = D0(i);
 285  Sp.l(l)   = Sp0(l);
 286  Sg.l      = Sg0;
 287  Td.l(l)   = Td0(l);
 288  Tz.l(j)   = Tz0(j);
 289  Tm.l(i)   = Tm0(i);
 290  CssH.l(l) = CssH0(l);
 291  CssE.l(i) = CssE0(i);
 292   
 293  * Setting lower bounds to avoid division by zero
 294  * hay que admitir el 0 para aquellas variables que resultarán con valor 0 al aplicar
 295  * las ecuaciones, como:
 296  *   las ayudas del gobierno que tienen coeficiente 0,
 297  *   el Sp para HOH3
 298  *   los Td para HOH3
 299  * un valor 0 de inicio no es problema porque GAMS lo cambia automáticamente al valo 'lo'
 300  pf.lo(h)    = 0.000001;
 301  py.lo(j)    = 0.000001;
 302  pz.lo(j)    = 0.000001;
 303  pq.lo(i)    = 0.000001;
 304  pe.lo(i)    = 0.000001;
 305  pm.lo(i)    = 0.000001;
 306  pd.lo(i)    = 0.000001;
 307  epsilon.lo  = 0.000001;
 308  Y.lo(j)     = 0.000001;
 309  F.lo(h,j)   = 0.000001;
 310  X.lo(i,j)   = 0.000001;
 311  Z.lo(j)     = 0.000001;
 312  Xp.lo(l,i)  = 0.000001;
 313  Xg.lo(i)    = 0.000001;
 314  Xv.lo(i)    = 0.000001;
 315  E.lo(i)     = 0.000001;
 316  M.lo(i)     = 0.000001;
 317  Q.lo(i)     = 0.000001;
 318  D.lo(i)     = 0.000001;
 319  Sp.lo(l)    = 0.00000;
 320  Td.lo(l)    = 0.00000;
 321  Tz.lo(j)    = 0.000001;
 322  Tm.lo(i)    = 0.000001;
 323  CssH.lo(l)  = 0.000001;
 324  CssE.lo(i)  = 0.000001;
 325   
 326  * para evitar infactibilidad, ya que partimos de déficit público, ahorro (Sg) = -3
 327  * que hace que el coeficiente de ahorro (ssg) sea negativo y al aplicar la función que
 328  * calcula Sg produzca valores negativos
 329  Sg.lo       = -100.;
 330   
 331  * numeraire
 332  * con pf.fx hacemos que pf.lo y pf.up sean 1, lo que significa que pf sólo puede valer 1
 333  pf.fx("LAB") = 1;
 334   
 335  Model stdcge / all /;
 336   
 337  *option limrow = 6 ;
 338   
 339  * para no buscat una solución y simplemente aplicat las ecuaciones con los valores de partida
 340  *stdcge.iterlim = 1
 341   
 342  solve stdcge maximizing UU using nlp;
 343   
 344  execute_unload 'solucion3H1.gdx'
 345     Y.l,
 346     F.l,
 347     FF,
 348     X.l,
 349     Z.l,
 350     Xp.l,
 351     Xg.l,
 352     Xv.l,
 353     E.l,
 354     M.l,
 355     Q.l,
 356     D.l,
 357     pf.l,
 358     py.l,
 359     pz.l,
 360     pq.l,
 361     pe.l,
 362     pm.l,
 363     pd.l,
 364     epsilon,
 365     Sp.l,
 366     Sg.l,
 367     Td.l,
 368     Tz.l,
 369     Tm.l,
 370     CssH.l,
 371     CssE.l,
 372     Sf,
 373     alpha,
 374     beta,
 375     b,
 376     ax,
 377     ay,
 378     mu,
 379     lambda,
 380     deltam,
 381     deltad,
 382     gamma,
 383     xid,
 384     xie,
 385     theta,
 386     ssp,
 387     ssg,
 388     taud,
 389     tauz,
 390     taum,
 391     ctzsse,
 392     ctzssh
 393  ;
 394   
 395  Parameter
 396      qq(i);
 397  qq(i) = sum(l,Xp.l(l,i))+Xg.l(i)+Xv.l(i)+sum(j,X.l(i,j));
 398   
 399  display 'Comprobación del cierre'
 400  display qq;
 401  display Q.l;
 402   
 403  Parameter
 404     UU0(l) 'utility level in the base run eq.'
 405     ep0(l) 'expenditure func. in the base run eq.'
 406     ep1(l) 'expenditure func. in the C-f eq.'
 407     EV(l)  'Hicksian equivalent variations';
 408   
 409  UU0(l) = prod(i, Xp0(l,i)**alpha(l,i));
 410  ep0(l) = UU0(l) /prod(i, (alpha(l,i)/1)**alpha(l,i));
 411  ep1(l) = (prod(i,Xp.l(l,i)**alpha(l,i))) /prod(i, (alpha(l,i)/1)**alpha(l,i));
 412  EV(l)  = ep1(l) - ep0(l);
 413   
 414  display EV;
 415   
 416  * Incremento del 10% para los factores prestados por los hogares
 417   
 418  FF(l,h) = 1.1 * FF(l,h);
 419   
 420  pf.fx("LAB") = 1;
 421   
 422  * Si se fija el valor de pf.lo("LAB") el modelo se vuelve infactible
 423  pf.lo("LAB") = -inf;
 424  pf.up("LAB") = +inf;
 425   
 426  option bRatio = 1;
 427   
 428  solve stdcge maximizing UU using nlp;
 429   
 430  execute_unload 'solucion3H2.gdx'
 431     Y.l,
 432     F.l,
 433     FF,
 434     X.l,
 435     Z.l,
 436     Xp.l,
 437     Xg.l,
 438     Xv.l,
 439     E.l,
 440     M.l,
 441     Q.l,
 442     D.l,
 443     pf.l,
 444     py.l,
 445     pz.l,
 446     pq.l,
 447     pe.l,
 448     pm.l,
 449     pd.l,
 450     epsilon,
 451     Sp.l,
 452     Sg.l,
 453     Td.l,
 454     Tz.l,
 455     Tm.l,
 456     CssH.l,
 457     CssE.l,
 458     Sf,
 459     alpha,
 460     beta,
 461     b,
 462     ax,
 463     ay,
 464     mu,
 465     lambda,
 466     deltam,
 467     deltad,
 468     gamma,
 469     xid,
 470     xie,
 471     theta,
 472     ssp,
 473     ssg,
 474     taud,
 475     tauz,
 476     taum,
 477     ctzsse,
 478     ctzssh
 479  ;
 480   
 481  Parameter
 482      qq(i);
 483  qq(i) = sum(l,Xp.l(l,i))+Xg.l(i)+Xv.l(i)+sum(j,X.l(i,j));
 484   
 485  display 'Comprobación del cierre'
 486  display qq;
 487  display Q.l;
 488   
 489  Parameter
 490     UU0(l) 'utility level in the base run eq.'
 491     ep0(l) 'expenditure func. in the base run eq.'
 492     ep1(l) 'expenditure func. in the C-f eq.'
 493     EV(l)  'Hicksian equivalent variations';
 494   
 495  UU0(l) = prod(i, Xp0(l,i)**alpha(l,i));
 496  ep0(l) = UU0(l) /prod(i, (alpha(l,i)/1)**alpha(l,i));
 497  ep1(l) = (prod(i,Xp.l(l,i)**alpha(l,i))) /prod(i, (alpha(l,i)/1)**alpha(l,i));
 498  EV(l)  = ep1(l) - ep0(l);
 499   
 500  display EV;
