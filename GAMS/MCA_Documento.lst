GAMS 51.1.0  2d039df5 Sep 13, 2025          WEX-WEI x86 64bit/MS Windows - 09/20/25 14:54:07 Page 1
Modelo ampliado con MCS: MCA-ESP-05
C o m p i l a t i o n


   2   
      basado en el libro:
      Handbook of Computible General Equilibrium Modeling
      Hosoe, N, Gasawa, K, and Hashimoto, H
      University of Tokyo Press, Tokyo, Japan, 2004
   9   
  10  Set
  11     u      'cuentas de la MCS'  / AP1, AP2, AP3, AP4, AP5, AP6, L, K, C1, C2, A-I, CSS, INP, SP, SE, AYD /
  12     i(u)   'sectores'           / AP1, AP2, AP3, AP4, AP5, AP6                                           /
  13     h(u)   'factores'           /                               L, K                                     /
  14     l(u)   'hogares'            /                                     C1, C2                             /;
  15   
  16  Alias (u,v), (i,j), (h,k), (l,n);
  17   
  18  Parameter SAM(u,v);
  30   
  31  display SAM;
  32   
  33  * cargando los valores iniciales
  34  Parameter
  35     Y0(j)     'factor compuesto de las empresas j'
  36     F0(h,j)   'los factores h empleados por las empresas j'
  37     X0(i,j)   'inputs intermedios'
  38     Z0(j)     'producción de las empresas j'
  39     Xp0(l,i)  'consumo de los hogares l de los productos i'
  40     Xg0(i)    'consumo del gobierno del producto i'
  41     Xv0(i)    'demanda de inversión de la empresa i'
  42     E0(i)     'exportaciones de las empresas i'
  43     M0(i)     'importaciones de las empresas i'
  44     Q0(i)     "producto compuesto de Armington de las empresas i"
  45     D0(i)     'consumo domestico de los productos i'
  46     Sp0(l)    'ahorro de los hogares l'
  47     Sg0       'ahorro del gobierno'
  48     Td0(l)    'impuestos a los hogares l'
  49     Tz0(j)    'impuestos a las producciones j'
  50     Tm0(j)    'aranceles a los productos j'
  51     FF(l,h)   'factores h prestados por los hogares l'
  52     Sf        'ahorro exterior en moneda local'
  53     CssH0(l)  'pagos a la seguridad social de los hogares l'
  54     CssE0(i)  'pagos a la seguridad social de las empresas i'
  55     PssH0(l)  'pensiones de los hogares l'
  56     AgE0(i)   'ayudas del gobierno a las empresas i'
  57     AgH0(l)   'ayudas del gobierno a los hogares l'
  58     pWe(i)    'precio de exportación en moneda local'
  59     pWm(i)    'precio de importación en moneda local'
  60     tauz(i)   'tasa de impuestos a las producciones j'
  61     taum(i)   'tasa de aranceles a los productos j'
  62     ctzsse(i) 'tasa de la seg.social a las empresas i'
  63     ctzssh(l) 'tasa de la seg.social a los hogares l'
  64  ;
  65  Td0(l)   = SAM("SP",l)+SAM("INP",l);
  66  Tz0(j)   = SAM("INP",j);
  67  Tm0(j)   = 0.000001;
  68  F0(h,j)  = SAM(h,j);
  69  Y0(j)    = sum(h, F0(h,j));
  70  X0(i,j)  = SAM(i,j);
  71  Z0(j)    = Y0(j) +sum(i, X0(i,j));
  72  M0(i)    = SAM("SE",i);
  73  CssE0(i) = SAM("CSS",i);
  74  CssH0(l) = SAM("CSS",l);
  75  PssH0(l) = SAM(l,"CSS");
  76  AgE0(i)  = SAM(i,'AYD');
  77  AgH0(l)  = SAM(l,'AYD');
  78  tauz(j)$(Z0(j) eq 0)  = 0.;
  79  tauz(j)$(Z0(j) ne 0)  = Tz0(j)/Z0(j);
  80  taum(j)$(M0(j) eq 0)  = 0.;
  81  taum(j)$(M0(j) ne 0)  = Tm0(j)/M0(j);
  82  Xp0(l,i) = SAM(i,l);
  83  FF(l,h)  = SAM(l,h);
  84  Xg0(i)   = SAM(i,"SP");
  85  Xv0(i)   = SAM(i,"A-I");
  86  E0(i)    = SAM(i,"SE");
  87  Q0(i)    = sum(l, Xp0(l,i))+Xg0(i)+Xv0(i)+sum(j, X0(i,j));
  88  D0(i)    = (1+tauz(i))*Z0(i)-E0(i)+CssE0(i)-AgE0(i);
  89  Sp0(l)   = SAM("A-I",l);
  90  Sg0      = SAM("A-I","SP");
  91  Sf       = SAM("A-I","SE");
  92  ctzsse(i) = CssE0(i)/F0('L',i);
  93  ctzssh(l)$(FF(l,'L')+PssH0(l) eq 0) = 0.;
  94  ctzssh(l)$(FF(l,'L')+PssH0(l) ne 0) = CssH0(l)/(FF(l,'L')+PssH0(l));
  95  pWe(i)   = 1;
  96  pWm(i)   = 1;
  97   
  98  display FF,F0,Y0,X0,Xp0,Xg0,Xv0,Q0,Z0,E0,M0,D0,Tz0,Tm0,Sp0,Td0,AgE0,AgH0,Sg0,Sf,
  99          CssE0,CssH0,PssH0;
 100   
 101  * calibrado
 102  Parameter
 103     sigma(i) 'elasticidad de sustitución (importación) de los sectores i'
 104     psi(i)   'elasticidad de transformación entre local y exportación (CET) de los sectores i'
 105     eta(i)   'parámetro de elasticidad de sustitución  de los sectores i'
 106     phi(i)   'parámetro de elasticidad de transformación de los sectores i';
 107   
 108  sigma(i) =  2;
 109  psi(i)   =  2;
 110  eta(i)   = (sigma(i) - 1)/sigma(i);
 111  phi(i)   = (psi(i) + 1)/psi(i);
 112   
 113  Parameter
 114     alpha(l,i) 'participación de los productos i en la función de utilidad de los hogares l'
 115     beta(h,j)  'participación de los factores h en la función de producción de las empresas j'
 116     b(j)       'parámetro de eswcala de la función de producción de las empresas j'
 117     ax(i,j)    'coeficietes de los imputs intermedios'
 118     ay(j)      'coeficiente del input de factor compuesto para las empresas j'
 119     mu(i)      'participación del producto i en el consumo del gobierno'
 120     lambda(i)  'participación en la demanda de inversión de las empresas i'
 121     deltam(i)  'participación de la importación de productos i en la función de Armington'
 122     deltad(i)  'participación de la producción local de productos i en la función de Armington'
 123     gamma(i)   'parámetro de escala de la función de producción de Armington de las empresas i'
 124     xid(i)     'coeficiente de participación en la CET de la demanda local de los sectores i'
 125     xie(i)     'coeficiente de participación en la CET de la exportación de los sectores i'
 126     theta(i)   'coeficiente de escala de la CET de exportación de los sectores i'
 127     ssp(l)     'apropensión al ahorro de los hogares l'
 128     ssg        'propensión al ahorro del gobierno'
 129     taud(l)    'tasa de impuestos directos a los hogares l'
 130     cage(i)    'coeficiente de las ayudas del gobierno a las empresas i'
 131     cagh(l)    'coeficiente de las ayudas del gobierno a los hogares l'
 132     alpha_c(l,i)'copia de alpha'
 133     beta_c(h,j) 'copia'
 134  ;
 135  alpha(l,i)  =  Xp0(l,i)/sum(j, Xp0(l,j));
 136  beta(h,j)   =  F0(h,j)/sum(k, F0(k,j));
 137  b(j)        =  Y0(j)/prod(h, F0(h,j)**beta(h,j));
 138  ax(i,j)     =  X0(i,j)/Z0(j);
 139  ay(j)       =  Y0(j)/Z0(j);
 140  mu(i)       =  Xg0(i)/sum(j, Xg0(j));
 141  lambda(i)   =  Xv0(i)/(sum(l,Sp0(l))+Sg0+Sf);
 142  deltam(i)   = (1+taum(i))*M0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 143  deltad(i)   =  D0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 144  gamma(i)    =  Q0(i)/(deltam(i)*M0(i)**eta(i)+deltad(i)*D0(i)**eta(i))**(1/eta(i));
 145  xie(i)      =  E0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 146  xid(i)      =  D0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 147  theta(i)    =  Z0(i)/(xie(i)*E0(i)**phi(i)+xid(i)*D0(i)**phi(i))**(1/phi(i));
 148  ssp(l)$((sum(h, FF(l,h))+ PssH0(l)) eq 0) = 0.;
 149  ssp(l)$((sum(h, FF(l,h))+ PssH0(l)) ne 0) = Sp0(l)/(sum(h, FF(l,h))+ PssH0(l));
 150  ssg         =  Sg0/(sum(l,Td0(l))+sum(j,Tz0(j))+sum(j,Tm0(j))-sum(j,AgE0(j))-sum(l,AgH0(l)));
 151  taud(l)$((sum(h, FF(l,h))+ PssH0(l)) eq 0) = 0.;
 152  taud(l)$((sum(h, FF(l,h))+ PssH0(l)) ne 0) = Td0(l)/(sum(h, FF(l,h))+ PssH0(l));
 153  cage(i)     = AgE0(i) / (sum(n,Td0(n)) + sum(j,Tz0(j)) + sum(j,Tm0(j)));
 154  cagh(l)     = AgH0(l) / (sum(n,Td0(n)) + sum(j,Tz0(j)) + sum(j,Tm0(j)));
 155   
 156  alpha_c(l,i)=alpha(l,i);
 157  beta_c(h,j) =beta(h,j)
 158   
 159  display phi,tauz,taum,alpha,beta,b,ax,ay,mu,lambda,deltam,deltad,gamma,xie,xid,
 160          theta,ssp,ssg,taud,ctzsse,ctzssh,cage,cagh;
 161   
 162  Variable
 163     Y(j)     'factor compuesto de los sectores i'
 164     F(h,i)   'uso de los factores h por los sectores i'
 165     X(i,j)   'consumo intermedio de los productos i por los sectores j'
 166     Z(i)     'producción bruta de los sectores i'
 167     Xp(l,i)  'demanda de los hogares l del producto i'
 168     Xg(i)    'demanda del gobierno de los productos i'
 169     Xv(i)    'demanda de inversión de los sectores i'
 170     E(i)     'exportaciones de los productos i'
 171     M(i)     'importaciones de los productos i'
 172     Q(i)     "producción del producto compuesto de Armington por los sectores i"
 173     D(i)     'demanda local de los productos i'
 174     pf(h)    'precio de los factores h'
 175     py(i)    'precio de los factores compuestos i'
 176     pz(i)    'precio de producir los productos locales i'
 177     pq(i)    "precio de los productos compuesto de Armington i"
 178     pe(i)    'precio de exportación de los productos i en moneda local'
 179     pm(i)    'precio de importación de los productos i en moneda local'
 180     pd(i)    'precio de los productos i para los compradores locales'
 181     epsilon  'cotización: moneda local/ moneda extranjera'
 182     Sp(l)    'ahorro de los hogares l'
 183     Sg       'ahorro del gobierno'
 184     Td(l)    'impuestos directos a los hogares l'
 185     Tz(i)    'impuesto a la producción de los sectores i'
 186     Tm(i)    'arancel de importación para los productos i'
 187     CssH(l)  'pagos a la seguridad social de los hogares l'
 188     CssE(i)  'pagos a la seguridad social de las empresas i'
 189     AgE(i)   'ayudas del gobierno a las empresas i'
 190     AgH(l)   'ayudas del gobierno a los hogares l'
 191     Apz      'holgura de los pseudo impuestos CssE CssH AgE AgH sobre Z'
 192     UU       'utilidad [ficticia]'
 193  ;
 194   
 195  Equation
 196     eqpy(i)     'producción del factor compuesto de los sectores i'
 197     eqF(h,j)    'uso de los factores h por los sectores i'
 198     eqX(i,j)    'consumo intermedio de los productos i por los sectores j'
 199     eqY(i)      'demanda del factor compuesto de los sectores i'
 200     eqpzs(i)    'coste unitario de producción de los sectores i'
 201     eqTd(l)     'impuestos directos a los hogares l'
 202     eqTz(i)     'impuesto a la producción de los sectores i'
 203     eqTm(i)     'arancel de importación para los productos i'
 204     eqAgE(i)    'ayudas del gobierno a las empresas i'
 205     eqAgH(l)    'ayudas del gobierno a los hogares l'
 206     eqSp(l)     'ahorro de los hogares l'
 207     eqSg        'ahorro del gobierno'
 208     eqctzsse(i) 'cotización seg social de las empresas i'
 209     eqctzssh(l) 'cotización seg social de los hogares l'
 210     eqXg(i)     'demanda del gobierno de los productos i'
 211     eqXv(i)     'demanda de inversión de los sectores i'
 212     eqXp(l,i)   'demanda de los hogares l del producto i'
 213     eqpe(i)     'precio de exportación de los productos i en moneda extranjera'
 214     eqpm(i)     'precio de importación de los productos i en moneda extranjera'
 215     eqepsilon   'balanza de pagos'
 216     eqpqs(i)    'función de Armington para los productos i'
 217     eqM(i)      'importaciones de los productos i'
 218     eqD(i)      'domestic good demand function'
 219     eqpzd(i)    'transformation function'
 220     eqDs(i)     'demanda local de los productos i'
 221     eqE(i)      'exportaciones de los productos i'
 222     eqpqd(i)    'condición de equilibrio del mercado para el producto compuesto de los sectores i'
 223     eqpf(h)     'condición de equilibrio del mercado para los factores h'
 224     obj         'utilidad [ficticia]'
 225  ;
 226   
 227  * comercio internacional
 228  eqpe(i)..   pe(i)     =e= epsilon*pWe(i);
 229  eqpm(i)..   pm(i)     =e= epsilon*pWm(i);
 230  eqepsilon.. sum(i, pWe(i)*E(i)) + Sf =e= sum(i, pWm(i)*M(i));
 231  * producción factor compuesto
 232  eqpy(j)..     Y(j)    =e= b(j)*prod(h, F(h,j)**beta(h,j));
 233  eqF(h,j)..    F(h,j)  =e= beta(h,j)*py(j)*Y(j)/pf(h);
 234  eqX(i,j)..    X(i,j)  =e= ax(i,j)*Z(j);
 235  eqY(j)..      Y(j)    =e= ay(j)*Z(j);
 236  eqpzs(j)..    pz(j)   =e= ay(j)*py(j)+sum(i, ax(i,j)*pq(i));
 237  * gobierno
 238  eqTd(l)..     Td(l)   =e= taud(l) * (sum(h, pf(h)*FF(l,h))+PssH0(l));
 239  eqTz(j)..     Tz(j)   =e= tauz(j)*pz(j)*Z(j);
 240  eqTm(i)..     Tm(i)   =e= taum(i)*pm(i)*M(i);
 241  eqAgE(i)..    AgE(i)  =e= cage(i) * (sum(n,Td(n))+sum(j,Tz(j))+sum(j,Tm(j)));
 242  eqAgH(l)..    AgH(l)  =e= cagh(l) * (sum(n,Td(n))+sum(j,Tz(j))+sum(j,Tm(j)));
 243  * ahorro
 244  eqSp(l)..     Sp(l)   =e= ssp(l) * (sum(h, pf(h)*FF(l,h))+PssH0(l));
 245  eqSg..        Sg      =e= ssg*(sum(l,Td(l))+sum(j,Tz(j))+sum(j,Tm(j))-sum(j,AgE(j))-sum(l,AgH(l)));
 246  eqXg(i)..     Xg(i)   =e= mu(i)   * (sum(l,Td(l))+sum(j,Tz(j))+sum(j,Tm(j))-Sg-sum(j,AgE(j))-sum(l,AgH(l)))/pq(i);
 247  eqctzsse(i).. CssE(i) =e= ctzsse(i) * F['L',i];
 248  eqctzssh(l).. CssH(l) =e= ctzssh(l) * (FF[l,'L'] + PssH0(l));
 249  * inversión
 250  eqXv(i)..     Xv(i)   =e= lambda(i)*(sum(l,Sp(l)) + Sg + epsilon*Sf)/pq(i);
 251  * consumo de los hogares
 252  eqXp(l,i)..   Xp(l,i) =e= alpha(l,i) * (sum(h,pf(h)*FF(l,h))+AgH(l)+PssH0(l)-(Sp(l)+Td(l)+CssH(l)))/pq(i);
 253  * producto de Armington
 254  eqpqs(i)..  Q(i)      =e=  gamma(i)*(deltam(i)*M(i)**eta(i) + deltad(i)*D(i)**eta(i))**(1/eta(i));
 255  eqM(i)..    M(i)      =e= (gamma(i)**eta(i)*deltam(i)*pq(i)/((1+taum(i))*pm(i)))**(1/(1-eta(i)))*Q(i);
 256  eqD(i)..    D(i)      =e= (gamma(i)**eta(i)*deltad(i)*pq(i)/pd(i))**(1/(1-eta(i)))*Q(i);
 257  * función de transformacion CET
 258  eqpzd(i)..  Z(i)      =e=  theta(i)*(xie(i)*E(i)**phi(i)+xid(i)*D(i)**phi(i))**(1/phi(i));
 259  eqE(i)..    E(i)      =e= (theta(i)**phi(i)*xie(i)*(1+tauz(i)+CssE(i)/Z(i)-AgE(i)/Z(i)+Apz)*pz(i)/pe(i))**(1/(1-phi(i)))*Z(i);
 260  eqDs(i)..   D(i)      =e= (theta(i)**phi(i)*xid(i)*(1+tauz(i)+CssE(i)/Z(i)-AgE(i)/Z(i)+Apz)*pz(i)/pd(i))**(1/(1-phi(i)))*Z(i);
 261  * condición de equilibrio del mercado
 262  eqpqd(i)..  Q(i)      =e= sum(l, Xp(l,i)) + Xg(i) + Xv(i) + sum(j, X(i,j));
 263  eqpf(h)..   sum(j, F(h,j)) =e= sum(l,FF(l,h));
 264   
 265  * función objetivo ficticia
 266  obj..       UU        =e= sum(l, prod(i, Xp(l,i)**alpha(l,i)))-100000.*Apz*Apz;
 267   
 268  * inicialización de variables
 269  Y.l(j)    = Y0(j);
 270  F.l(h,j)  = F0(h,j);
 271  X.l(i,j)  = X0(i,j);
 272  Z.l(j)    = Z0(j);
 273  Xp.l(l,i) = Xp0(l,i);
 274  Xg.l(i)   = Xg0(i);
 275  Xv.l(i)   = Xv0(i);
 276  E.l(i)    = E0(i);
 277  M.l(i)    = M0(i);
 278  Q.l(i)    = Q0(i);
 279  D.l(i)    = D0(i);
 280  pf.l(h)   = 1;
 281  py.l(j)   = 1;
 282  pz.l(j)   = 1;
 283  pq.l(i)   = 1;
 284  pe.l(i)   = 1;
 285  pm.l(i)   = 1;
 286  pd.l(i)   = 1;
 287  epsilon.l = 1;
 288  Sp.l(l)   = Sp0(l);
 289  Sg.l      = Sg0;
 290  Td.l(l)   = Td0(l);
 291  Tz.l(j)   = Tz0(j);
 292  Tm.l(i)   = Tm0(i);
 293  CssH.l(l) = CssH0(l);
 294  CssE.l(i) = CssE0(i);
 295  AgE.l(i)  = AgE0(i);
 296  AgH.l(l)  = AgH0(l);
 297  Apz.l     = 0.0;
 298   
 299  * cota inferior de las variables, puede eliminar o producir infactibilidad, según el caso
 300  Y.lo(j)     = 0.0000;
 301  F.lo(h,j)   = 0.0000;
 302  X.lo(i,j)   = 0.0000;
 303  Z.lo(j)     = 0.0000;
 304  Xp.lo(l,i)  = 0.0000;
 305  Xg.lo(i)    = 0.0000;
 306  Xv.lo(i)    = 0.0000;
 307  E.lo(i)     = 0.0000;
 308  M.lo(i)     = 0.0000;
 309  Q.lo(i)     = 0.0000;
 310  D.lo(i)     = 0.0000;
 311  pf.lo(h)    = 0.0000;
 312  py.lo(j)    = 0.0000;
 313  pz.lo(j)    = 0.0000;
 314  pq.lo(i)    = 0.0000;
 315  pe.lo(i)    = 0.0000;
 316  pm.lo(i)    = 0.0000;
 317  pd.lo(i)    = 0.0000;
 318  epsilon.lo  = 0.0000;
 319  Sp.lo(l)    = 0.0000;
 320  Sg.lo       = 0.0000;
 321  Td.lo(l)    = 0.0000;
 322  Tz.lo(j)    = 0.0000;
 323  Tm.lo(i)    = 0.0000;
 324  CssH.lo(l)  = 0.0000;
 325  CssE.lo(i)  = 0.0000;
 326  AgE.lo(i)   = 0.0000;
 327  AgH.lo(l)   = 0.0000;
 328   
 329  * precio de referencia
 330  pf.fx("L") = 1;
 331   
 332  Model mca / all /;
 333   
 334   
 335  option nlp=CONOPT;
 336  solve mca maximizing UU using nlp;
 337   
 338  * salvar a un fichero para después exportar (manualmente) a excel
 339   
 340  execute_unload 'base_excel.gdx'
 341     Y.l,F.l,FF,X.l,Z.l,Xp.l,Xg.l,Xv.l,E.l,M.l,Q.l,D.l,pf.l,py.l,pz.l,pq.l,pe.l,pm.l,pd.l,epsilon,
 342     Sp.l,Sg.l,Td.l,Tz.l,Tm.l,CssH.l,CssE.l,PssH0,AgE.l,AgH.l,Apz.l,Sf,
 343     alpha,beta,b,ax,ay,mu,lambda,deltam,deltad,gamma,xid,xie,theta,ssp,ssg,taud,tauz,taum,ctzsse,ctzssh,cage,cagh
 344  ;
 345   
 346  Parameter
 347      qq(i);
 348  qq(i) = sum(l,Xp.l(l,i))+Xg.l(i)+Xv.l(i)+sum(j,X.l(i,j));
 349   
 350  display 'Comprobación del equilibrio de mercado para el producto de Armington'
 351  display qq;
 352  display Q.l;
 353   
 354  * bienestar económico
 355  Parameter
 356     UU0(l) 'nivel de utilidad en el equilibrio de base'
 357     ep0(l) 'gasto en el equilibrio de base'
 358     ep1(l) 'gasto en el equilibrio del nuevo escenario'
 359     EV(l)  'variación equivalente de Hicksian'
 360  ;
 361   
 362  UU0(l) = prod(i, Xp0(l,i)**alpha(l,i));
 363  ep0(l) = UU0(l) /prod(i, (alpha(l,i)/1)**alpha(l,i));
 364  ep1(l) = (prod(i,Xp.l(l,i)**alpha(l,i))) / prod(i, (alpha(l,i)/1)**alpha(l,i));
 365  EV(l)  = ep1(l) - ep0(l);
 366   
 367  display EV;
