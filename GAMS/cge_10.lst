  33     GOV                             9     3    15      8
  34     INV                                        10      7     2          12
  35     EXT    13    11                                                       ;
  36   
  37  * Loading the initial values
  38  Parameter
  39     Y0(j)    'composite factor'
  40     F0(h,j)  'the h-th factor input by the j-th firm'
  41     X0(i,j)  'intermediate input'
  42     Z0(j)    'output of the j-th good'
  43     Xp0(l,i) 'household consumption of the i-th good '
  44     Xg0(i)   'government consumption'
  45     Xv0(i)   'investment demand'
  46     E0(i)    'exports'
  47     M0(i)    'imports'
  48     Q0(i)    "Armington's composite good"
  49     D0(i)    'domestic good'
  50     Sp0(l)   'private saving'
  51     Sg0      'government saving'
  52     Td0(l)   'direct tax'
  53     Tz0(j)   'production tax'
  54     Tm0(j)   'import tariff'
  55     FF(l,h)  'factor endowment of the h-th factor'
  56     Sf       'foreign saving in US dollars'
  57     pWe(i)   'export price in US dollars'
  58     pWm(i)   'import price in US dollars'
  59     tauz(i)  'production tax rate'
  60     taum(i)  'import tariff rate';
  61   
  62  Td0(l)   = SAM("GOV",l);
  63  Tz0(j)   = SAM("IDT",j);
  64  Tm0(j)   = SAM("TRF",J);
  65  F0(h,j)  = SAM(h,j);
  66  Y0(j)    = sum(h, F0(h,j));
  67  X0(i,j)  = SAM(i,j);
  68  Z0(j)    = Y0(j) +sum(i, X0(i,j));
  69  M0(i)    = SAM("EXT",i);
  70  tauz(j)  = Tz0(j)/Z0(j);
  71  taum(j)  = Tm0(j)/M0(j);
  72  Xp0(l,i) = SAM(i,l);
  73  FF(l,h)  = SAM(l,h);
  74  Xg0(i)   = SAM(i,"GOV");
  75  Xv0(i)   = SAM(i,"INV");
  76  E0(i)    = SAM(i,"EXT");
  77  Q0(i)    = sum(l, Xp0(l,i))+Xg0(i)+Xv0(i)+sum(j, X0(i,j));
  78  D0(i)    = (1+tauz(i))*Z0(i)-E0(i);
  79  Sp0(l)   = SAM("INV",l);
  80  Sg0      = SAM("INV","GOV");
  81  Sf       = SAM("INV","EXT");
  82  pWe(i)  = 1;
  83  pWm(i)  = 1;
  84   
  85  display Y0, F0, X0, Z0, Xp0, Xg0, Xv0, E0, M0, Q0, D0, Sp0, Sg0, Td0, Tz0, Tm0
  86          FF, Sf, tauz, taum;
  87   
  88  * Calibration
  89  Parameter
  90     sigma(i) 'elasticity of substitution'
  91     psi(i)   'elasticity of transformation'
  92     eta(i)   'substitution elasticity parameter'
  93     phi(i)   'transformation elasticity parameter';
  94   
  95  sigma(i) =  2;
  96  psi(i)   =  2;
  97  eta(i)   = (sigma(i) - 1)/sigma(i);
  98  phi(i)   = (psi(i) + 1)/psi(i);
  99   
 100  Parameter
 101     alpha(l,i) 'share parameter in utility func.'
 102     beta(h,j)  'share parameter in production func.'
 103     b(j)       'scale parameter in production func.'
 104     ax(i,j)    'intermediate input requirement coeff.'
 105     ay(j)      'composite fact. input req. coeff.'
 106     mu(i)      'government consumption share'
 107     lambda(i)  'investment demand share'
 108     deltam(i)  'share par. in Armington func.'
 109     deltad(i)  'share par. in Armington func.'
 110     gamma(i)   'scale par. in Armington func.'
 111     xid(i)     'share par. in transformation func.'
 112     xie(i)     'share par. in transformation func.'
 113     theta(i)   'scale par. in transformation func.'
 114     ssp(l)     'average propensity for private saving'
 115     ssg        'average propensity for gov. saving'
 116     taud(l)    'direct tax rate';
 117   
 118  alpha(l,i)  =  Xp0(l,i)/sum(j, Xp0(l,j));
 119  beta(h,j) =  F0(h,j)/sum(k, F0(k,j));
 120  b(j)      =  Y0(j)/prod(h, F0(h,j)**beta(h,j));
 121  ax(i,j)   =  X0(i,j)/Z0(j);
 122  ay(j)     =  Y0(j)/Z0(j);
 123  mu(i)     =  Xg0(i)/sum(j, Xg0(j));
 124  lambda(i) =  Xv0(i)/(sum(l,Sp0(l))+Sg0+Sf);
 125  deltam(i) = (1+taum(i))*M0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 126  deltad(i) =  D0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 127  gamma(i)  =  Q0(i)/(deltam(i)*M0(i)**eta(i)+deltad(i)*D0(i)**eta(i))**(1/eta(i));
 128  xie(i)    =  E0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 129  xid(i)    =  D0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 130  theta(i)  =  Z0(i)/(xie(i)*E0(i)**phi(i)+xid(i)*D0(i)**phi(i))**(1/phi(i));
 131  ssp(l)    =  Sp0(l)/sum(h, FF(l,h));
 132  ssg       =  Sg0/(sum(l,Td0(l))+sum(j, Tz0(j))+sum(j, Tm0(j)));
 133  taud(l)   =  Td0(l)/sum(h, FF(l,h));
 134   
 135  display alpha, beta,  b,   ax,  ay, mu, lambda, deltam, deltad, gamma, xie
 136          xid,   theta, ssp, ssg, taud, eta, phi;
 137   
 138  Variable
 139     Y(j)    'composite factor'
 140     F(h,j)  'the h-th factor input by the j-th firm'
 141     X(i,j)  'intermediate input'
 142     Z(j)    'output of the j-th good'
 143     Xp(l,i) 'household consumption of the i-th good'
 144     Xg(i)   'government consumption'
 145     Xv(i)   'investment demand'
 146     E(i)    'exports'
 147     M(i)    'imports'
 148     Q(i)    "Armington's composite good"
 149     D(i)    'domestic good'
 150     pf(h)   'the h-th factor price'
 151     py(j)   'composite factor price'
 152     pz(j)   'supply price of the i-th good'
 153     pq(i)   "Armington's composite good price"
 154     pe(i)   'export price in local currency'
 155     pm(i)   'import price in local currency'
 156     pd(i)   'the i-th domestic good price'
 157     epsilon 'exchange rate'
 158     Sp(l)   'private saving'
 159     Sg      'government saving'
 160     Td(l)   'direct tax'
 161     Tz(j)   'production tax'
 162     Tm(i)   'import tariff'
 163     UU      'utility [fictitious]';
 164   
 165  Equation
 166     eqpy(j)   'composite factor agg. func.'
 167     eqF(h,j)  'factor demand function'
 168     eqX(i,j)  'intermediate demand function'
 169     eqY(j)    'composite factor demand function'
 170     eqpzs(j)  'unit cost function'
 171     eqTd(l)   'direct tax revenue function'
 172     eqTz(j)   'production tax revenue function'
 173     eqTm(i)   'import tariff revenue function'
 174     eqXg(i)   'government demand function'
 175     eqXv(i)   'investment demand function'
 176     eqSp(l)   'private saving function'
 177     eqSg      'government saving function'
 178     eqXp(l,i) 'household demand function'
 179     eqpe(i)   'world export price equation'
 180     eqpm(i)   'world import price equation'
 181     eqepsilon 'balance of payments'
 182     eqpqs(i)  'Armington function'
 183     eqM(i)    'import demand function'
 184     eqD(i)    'domestic good demand function'
 185     eqpzd(i)  'transformation function'
 186     eqDs(i)   'domestic good supply function'
 187     eqE(i)    'export supply function'
 188     eqpqd(i)  'market clearing cond. for comp. good'
 189     eqpf(h)   'factor market clearing condition'
 190     obj       'utility function [fictitious]';
 191   
 192  * domestic production
 193  eqpy(j)..   Y(j)   =e= b(j)*prod(h, F(h,j)**beta(h,j));
 194   
 195  eqF(h,j)..  F(h,j) =e= beta(h,j)*py(j)*Y(j)/pf(h);
 196   
 197  eqX(i,j)..  X(i,j) =e= ax(i,j)*Z(j);
 198   
 199  eqY(j)..    Y(j)   =e= ay(j)*Z(j);
 200   
 201  eqpzs(j)..  pz(j)  =e= ay(j)*py(j) + sum(i, ax(i,j)*pq(i));
 202   
 203  * government behavior
 204  eqTd(l)..      Td(l)  =e= taud(l) * sum(h, pf(h)*FF(l,h));
 205   
 206  eqTz(j)..   Tz(j)  =e= tauz(j)*pz(j)*Z(j);
 207   
 208  eqTm(i)..   Tm(i)  =e= taum(i)*pm(i)*M(i);
 209   
 210  eqXg(i)..   Xg(i)  =e= mu(i)*(sum(l,Td(l)) + sum(j, Tz(j)) + sum(j, Tm(j)) - Sg)/pq(i);
 211   
 212  * investment behavior
 213  eqXv(i)..   Xv(i)  =e= lambda(i)*(sum(l,Sp(l)) + Sg + epsilon*Sf)/pq(i);
 214   
 215  * savings
 216  eqSp(l)..      Sp(l)  =e= ssp(l) * sum(h, pf(h)*FF(l,h));
 217   
 218  eqSg..      Sg     =e= ssg*(sum(l,Td(l)) + sum(j, Tz(j)) + sum(j, Tm(j)));
 219   
 220  * household consumption
 221  eqXp(l,i)..   Xp(l,i) =e= alpha(l,i) * (sum(h, pf(h)*FF(l,h)) - Sp(l) - Td(l))/pq(i);
 222   
 223  * international trade
 224  eqpe(i)..   pe(i)  =e= epsilon*pWe(i);
 225   
 226  eqpm(i)..   pm(i)  =e= epsilon*pWm(i);
 227   
 228  eqepsilon.. sum(i, pWe(i)*E(i)) + Sf =e= sum(i, pWm(i)*M(i));
 229   
 230  * Armington function
 231  eqpqs(i)..  Q(i)   =e=  gamma(i)*(deltam(i)*M(i)**eta(i) + deltad(i)*D(i)**eta(i))**(1/eta(i));
 232   
 233  eqM(i)..    M(i)   =e= (gamma(i)**eta(i)*deltam(i)*pq(i)/((1+taum(i))*pm(i)))**(1/(1-eta(i)))*Q(i);
 234   
 235  eqD(i)..    D(i)   =e= (gamma(i)**eta(i)*deltad(i)*pq(i)/pd(i))**(1/(1-eta(i)))*Q(i);
 236   
 237  * transformation function
 238  eqpzd(i)..  Z(i)   =e=  theta(i)*(xie(i)*E(i)**phi(i)+xid(i)*D(i)**phi(i))**(1/phi(i));
 239   
 240  eqE(i)..    E(i)   =e= (theta(i)**phi(i)*xie(i)*(1+tauz(i))*pz(i)/pe(i))**(1/(1-phi(i)))*Z(i);
 241   
 242  eqDs(i)..   D(i)   =e= (theta(i)**phi(i)*xid(i)*(1+tauz(i))*pz(i)/pd(i))**(1/(1-phi(i)))*Z(i);
 243   
 244  * market clearing condition
 245  eqpqd(i)..  Q(i)   =e= sum(l, Xp(l,i)) + Xg(i) + Xv(i) + sum(j, X(i,j));
 246   
 247  eqpf(h)..   sum(j, F(h,j)) =e= sum(l,FF(l,h));
 248   
 249  * fictitious objective function
 250  obj..       UU    =e= sum(l, prod(i, Xp(l,i)**alpha(l,i)));
 251   
 252  * Initializing variables
 253  Y.l(j)    = Y0(j);
 254  F.l(h,j)  = F0(h,j);
 255  X.l(i,j)  = X0(i,j);
 256  Z.l(j)    = Z0(j);
 257  Xp.l(l,i)   = Xp0(l,i);
 258  Xg.l(i)   = Xg0(i);
 259  Xv.l(i)   = Xv0(i);
 260  E.l(i)    = E0(i);
 261  M.l(i)    = M0(i);
 262  Q.l(i)    = Q0(i);
 263  D.l(i)    = D0(i);
 264  pf.l(h)   = 1;
 265  py.l(j)   = 1;
 266  pz.l(j)   = 1;
 267  pq.l(i)   = 1;
 268  pe.l(i)   = 1;
 269  pm.l(i)   = 1;
 270  pd.l(i)   = 1;
 271  epsilon.l = 1;
 272  Sp.l(l)   = Sp0(l);
 273  Sg.l      = Sg0;
 274  Td.l(l)   = Td0(l);
 275  Tz.l(j)   = Tz0(j);
 276  Tm.l(i)   = Tm0(i);
 277   
 278  * Setting lower bounds to avoid division by zero
 279  Y.lo(j)     = 0.00001;
 280  F.lo(h,j)   = 0.00001;
 281  X.lo(i,j)   = 0.00001;
 282  Z.lo(j)     = 0.00001;
 283  Xp.lo(l,i)  = 0.00001;
 284  Xg.lo(i)    = 0.00001;
 285  Xv.lo(i)    = 0.00001;
 286  E.lo(i)     = 0.00001;
 287  M.lo(i)     = 0.00001;
 288  Q.lo(i)     = 0.00001;
 289  D.lo(i)     = 0.00001;
 290  pf.lo(h)    = 0.00001;
 291  py.lo(j)    = 0.00001;
 292  pz.lo(j)    = 0.00001;
 293  pq.lo(i)    = 0.00001;
 294  pe.lo(i)    = 0.00001;
 295  pm.lo(i)    = 0.00001;
 296  pd.lo(i)    = 0.00001;
 297  epsilon.lo  = 0.00001;
 298  Sp.lo(l)    = 0.00001;
 299  Sg.lo       = 0.00001;
 300  Td.lo(l)    = 0.00001;
 301  Tz.lo(j)    = 0.0000;
 302  Tm.lo(i)    = 0.0000;
 303   
 304  * numeraire
 305  pf.fx("LAB") = 1;
 306   
 307  Model stdcge / all /;
 308   
 309  solve stdcge maximizing UU using nlp;
 310   
 311  * Simulation Runs: Abolition of Import Tariffs
 312  taum(i) = 0;
 313   
 314  option bRatio = 1;
 315   
 316  solve stdcge maximizing UU using nlp;


