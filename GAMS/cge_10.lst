  14   
  15  Set
  16     u    'SAM entry' / BRD, MLK, CAP, LAB, IDT, TRF, HOH1, HOH2, GOV, INV, EXT /
  17     i(u) 'goods'     / BRD, MLK                                                /
  18     h(u) 'factor'    /           CAP, LAB                                      /
  19     l(u) 'demanda'   /                               HOH1, HOH2                /;
  20   
  21  Alias (u,v), (i,j), (h,k);
  22   
  23  Table SAM(u,v) 'social accounting matrix'
  24           BRD   MLK   CAP   LAB   IDT   TRF   HOH1  HOH2   GOV   INV   EXT
  25     BRD    21     8                            10     10    19    16     8
  26     MLK    17     9                            20     10    14    15     4
  27     CAP    20    30
  28     LAB    15    25
  29     IDT     5     4
  30     TRF     1     2
  31     HOH1               45    10
