Modelo ampliado con MCS: MCA-ESP-05
C o m p i l a t i o n


   2   
      basado en el libro:
      Handbook of Computible General Equilibrium Modeling
      Hosoe, N, Gasawa, K, and Hashimoto, H
      University of Tokyo Press, Tokyo, Japan, 2004
   9   
  10  Set
  11     u      'cuentas de la MCS'  / AP1, AP2, AP3, AP4, AP5, AP6, L, K, C1, C2, A-I, CSS, INP, SP, SE, AYD /
  12     i(u)   'sectores'           / AP1, AP2, AP3, AP4, AP5, AP6                                           /
  13     h(u)   'factores'           /                               L, K                                     /
  14     l(u)   'hogares'            /                                     C1, C2                             /;
  15   
  16  Alias (u,v), (i,j), (h,k), (l,n);
  17   
  18  Parameter SAM(u,v);
  30   
  31  display SAM;
  32   
  33  * cargando los valores iniciales
  34  Parameter
  35     Y0(j)     'factor compuesto de las empresas j'
  36     F0(h,j)   'los factores h empleados por las empresas j'
  37     X0(i,j)   'inputs intermedios'
  38     Z0(j)     'producción de las empresas j'
  39     Xp0(l,i)  'consumo de los hogares l de los productos i'
  40     Xg0(i)    'consumo del gobierno del producto i'
  41     Xv0(i)    'demanda de inversión de la empresa i'
  42     E0(i)     'exportaciones de las empresas i'
  43     M0(i)     'importaciones de las empresas i'
  44     Q0(i)     "producto compuesto de Armington de las empresas i"
  45     D0(i)     'consumo domestico de los productos i'
  46     Sp0(l)    'ahorro de los hogares l'
  47     Sg0       'ahorro del gobierno'
  48     Td0(l)    'impuestos a los hogares l'
  49     Tz0(j)    'impuestos a las producciones j'
  50     Tm0(j)    'aranceles a los productos j'
  51     FF(l,h)  'factores h prestados por los hogares l'
  52     Sf        'ahorro exterior en moneda local'
  53     CssH0(l)  'pagos a la seguridad social de los hogares l'
  54     CssE0(i)  'pagos a la seguridad social de las empresas i'
  55     PssH0(l)  'pensiones de los hogares l'
  56     AgE0(i)   'ayudas del gobierno a las empresas i'
  57     AgH0(l)   'ayudas del gobierno a los hogares l'
  58     pWe(i)    'precio de exportación en moneda local'
  59     pWm(i)    'precio de importación en moneda local'
  60     tauz(i)   'tasa de impuestos a las producciones j'
  61     taum(i)   'tasa de aranceles a los productos j'
  62     ctzsse(i) 'tasa de la seg.social a las empresas i'
  63     ctzssh(l) 'tasa de la seg.social a los hogares l'
  64     Alp0(l,h)
  65     DeAd(l,i)
  66  ;
  67  Td0(l)   = SAM("SP",l)+SAM("INP",l);
  68  Tz0(j)   = SAM("INP",j);
  69  Tm0(j)   = 0.000001;
  70  F0(h,j)  = SAM(h,j);
  71  Y0(j)    = sum(h, F0(h,j));
  72  X0(i,j)  = SAM(i,j);
  73  Z0(j)    = Y0(j) +sum(i, X0(i,j));
  74  M0(i)    = SAM("SE",i);
  75  CssE0(i) = SAM("CSS",i);
  76  CssH0(l) = SAM("CSS",l);
  77  PssH0(l) = SAM(l,"CSS");
  78  AgE0(i)  = SAM(i,'AYD');
  79  AgH0(l)  = SAM(l,'AYD');
  80  tauz(j)$(Z0(j) eq 0)  = 0.;
  81  tauz(j)$(Z0(j) ne 0)  = Tz0(j)/Z0(j);
  82  taum(j)$(M0(j) eq 0)  = 0.;
  83  taum(j)$(M0(j) ne 0)  = Tm0(j)/M0(j);
  84  Xp0(l,i) = SAM(i,l);
  85  FF(l,h)  = SAM(l,h);
  86  Xg0(i)   = SAM(i,"SP");
  87  Xv0(i)   = SAM(i,"A-I");
  88  E0(i)    = SAM(i,"SE");
  89  Q0(i)    = sum(l, Xp0(l,i))+Xg0(i)+Xv0(i)+sum(j, X0(i,j));
  90  D0(i)    = (1+tauz(i))*Z0(i)-E0(i)+CssE0(i)-AgE0(i);
  91  Sp0(l)   = SAM("A-I",l);
  92  Sg0      = SAM("A-I","SP");
  93  Sf       = SAM("A-I","SE");
  94  ctzsse(i) = CssE0(i)/F0('L',i);
  95  ctzssh(l)$(FF(l,'L') eq 0) = 0.;
  96  ctzssh(l)$(FF(l,'L') ne 0) = CssH0(l)/FF(l,'L');
  97  pWe(i)   = 1;
  98  pWm(i)   = 1;
  99  Alp0(l,h) = 0;
 100  DeAd(l,i) = 0;
 101   
 102  display FF,F0,Y0,X0,Xp0,Xg0,Xv0,Q0,Z0,E0,M0,D0,Tz0,Tm0,Sp0,Td0,AgE0,AgH0,Sg0,Sf,
 103          CssE0,CssH0,PssH0,Alp0,DeAd;
 104   
 105  * calibrado
 106  Parameter
 107     sigma(i) 'elasticidad de sustitución (importación) de los sectores i'
 108     psi(i)   'elasticidad de transformación entre local y exportación (CET) de los sectores i'
 109     eta(i)   'parámetro de elasticidad de sustitución  de los sectores i'
 110     phi(i)   'parámetro de elasticidad de transformación de los sectores i';
 111   
 112  sigma(i) =  2;
 113  psi(i)   =  2;
 114  eta(i)   = (sigma(i) - 1)/sigma(i);
 115  phi(i)   = (psi(i) + 1)/psi(i);
 116   
 117  Parameter
 118     alpha(l,i) 'participación de los productos i en la función de utilidad de los hogares l'
 119     beta(h,j)  'participación de los factores h en la función de producción de las empresas j'
 120     b(j)       'parámetro de eswcala de la función de producción de las empresas j'
 121     ax(i,j)    'coeficietes de los imputs intermedios'
 122     ay(j)      'coeficiente del input de factor compuesto para las empresas j'
 123     mu(i)      'participación del producto i en el consumo del gobierno'
 124     lambda(i)  'participación en la demanda de inversión de las empresas i'
 125     deltam(i)  'participación de la importación de productos i en la función de Armington'
 126     deltad(i)  'participación de la producción local de productos i en la función de Armington'
 127     gamma(i)   'parámetro de escala de la función de producción de Armington de las empresas i'
 128     xid(i)     'coeficiente de participación en la CET de la demanda local de los sectores i'
 129     xie(i)     'coeficiente de participación en la CET de la exportación de los sectores i'
 130     theta(i)   'coeficiente de escala de la CET de exportación de los sectores i'
 131     ssp(l)     'apropensión al ahorro de los hogares l'
 132     ssg        'propensión al ahorro del gobierno'
 133     taud(l)    'tasa de impuestos directos a los hogares l'
 134     cage(i)    'coeficiente de las ayudas del gobierno a las empresas i'
 135     cagh(l)    'coeficiente de las ayudas del gobierno a los hogares l'
 136     alpha_c(l,i)'copia de alpha'
 137     beta_c(h,j) 'copia'
 138     rf(l,h)     'parámetro intermedio para calcular Alp'
 139  ;
 140  alpha(l,i)  =  Xp0(l,i)/sum(j, Xp0(l,j));
 141  beta(h,j)   =  F0(h,j)/sum(k, F0(k,j));
 142  b(j)        =  Y0(j)/prod(h, F0(h,j)**beta(h,j));
 143  ax(i,j)     =  X0(i,j)/Z0(j);
 144  ay(j)       =  Y0(j)/Z0(j);
 145  mu(i)       =  Xg0(i)/sum(j, Xg0(j));
 146  lambda(i)   =  Xv0(i)/(sum(l,Sp0(l))+Sg0+Sf);
 147  deltam(i)   = (1+taum(i))*M0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 148  deltad(i)   =  D0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 149  gamma(i)    =  Q0(i)/(deltam(i)*M0(i)**eta(i)+deltad(i)*D0(i)**eta(i))**(1/eta(i));
 150  xie(i)      =  E0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 151  xid(i)      =  D0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 152  theta(i)    =  Z0(i)/(xie(i)*E0(i)**phi(i)+xid(i)*D0(i)**phi(i))**(1/phi(i));
 153  ssp(l)$((sum(h, FF(l,h))+ PssH0(l)) eq 0) = 0.;
 154  ssp(l)$((sum(h, FF(l,h))+ PssH0(l)) ne 0) = Sp0(l)/(sum(h, FF(l,h))+ PssH0(l));
 155  ssg         =  Sg0/(sum(l,Td0(l))+sum(j,Tz0(j))+sum(j,Tm0(j))-sum(j,AgE0(j))-sum(l,AgH0(l)));
 156  taud(l)$((sum(h, FF(l,h))+ PssH0(l)) eq 0) = 0.;
 157  taud(l)$((sum(h, FF(l,h))+ PssH0(l)) ne 0) = Td0(l)/(sum(h, FF(l,h))+ PssH0(l));
 158  cage(i)     = AgE0(i) / (sum(n,Td0(n)) + sum(j,Tz0(j)) + sum(j,Tm0(j)));
 159  cagh(l)     = AgH0(l) / (sum(n,Td0(n)) + sum(j,Tz0(j)) + sum(j,Tm0(j)));
 160  rf(l,h)     = FF(l,h) / sum(n,FF(n,h));
 161   
 162  alpha_c(l,i)=alpha(l,i);
 163  beta_c(h,j) =beta(h,j)
 164   
 165  display phi,tauz,taum,alpha,beta,b,ax,ay,mu,lambda,deltam,deltad,gamma,xie,xid,
 166          theta,ssp,ssg,taud,ctzsse,ctzssh,cage,cagh,rf;
 167   
 168  Variable
 169     Y(j)     'factor compuesto de los sectores i'
 170     F(h,i)   'uso de los factores h por los sectores i'
 171     X(i,j)   'consumo intermedio de los productos i por los sectores j'
 172     Z(i)     'producción bruta de los sectores i'
 173     Xp(l,i)  'demanda de los hogares l del producto i'
 174     Xg(i)    'demanda del gobierno de los productos i'
 175     Xv(i)    'demanda de inversión de los sectores i'
 176     E(i)     'exportaciones de los productos i'
 177     M(i)     'importaciones de los productos i'
 178     Q(i)     "producción del producto compuesto de Armington por los sectores i"
 179     D(i)     'demanda local de los productos i'
 180     pf(h)    'precio de los factores h'
 181     py(i)    'precio de los factores compuestos i'
 182     pz(i)    'precio de producir los productos locales i'
 183     pq(i)    "precio de los productos compuesto de Armington i"
 184     pe(i)    'precio de exportación de los productos i en moneda local'
 185     pm(i)    'precio de importación de los productos i en moneda local'
 186     pd(i)    'precio de los productos i para los compradores locales'
 187     epsilon  'cotización: moneda local/ moneda extranjera'
 188     Sp(l)    'ahorro de los hogares l'
 189     Sg       'ahorro del gobierno'
 190     Td(l)    'impuestos directos a los hogares l'
 191     Tz(i)    'impuesto a la producción de los sectores i'
 192     Tm(i)    'arancel de importación para los productos i'
 193     CssH(l)  'pagos a la seguridad social de los hogares l'
 194     CssE(i)  'pagos a la seguridad social de las empresas i'
 195     AgE(i)   'ayudas del gobierno a las empresas i'
 196     AgH(l)   'ayudas del gobierno a los hogares l'
 197     Apz      'holgura de los pseudo impuestos CssE CssH AgE AgH sobre Z'
 198     Alp(l,h) 'ahorro a largo plazo del factor h por el hogar l'
 199     UU       'utilidad [ficticia]'
 200  ;
 201   
 202  Equation
 203     eqpy(i)     'producción del factor compuesto de los sectores i'
 204     eqF(h,j)    'uso de los factores h por los sectores i'
 205     eqX(i,j)    'consumo intermedio de los productos i por los sectores j'
 206     eqY(i)      'demanda del factor compuesto por los sectores i'
 207     eqpzs(i)    'precio (coste unitario) de la producción bruta de los sectores i'
 208     eqTd(l)     'impuestos directos a los hogares l'
 209     eqTz(i)     'impuesto a la producción de los sectores i'
 210     eqTm(i)     'arancel de importación para los productos i'
 211     eqAgE(i)    'ayudas del gobierno a las empresas i'
 212     eqAgH(l)    'ayudas del gobierno a los hogares l'
 213     eqSp(l)     'ahorro de los hogares l'
 214     eqSg        'ahorro del gobierno'
 215     eqctzsse(i) 'cotización seg social de las empresas i'
 216     eqctzssh(l) 'cotización seg social de los hogares l'
 217     eqXg(i)     'demanda del gobierno de los productos i'
 218     eqXv(i)     'demanda de inversión de los sectores i'
 219     eqXp(l,i)   'demanda de los hogares l del producto i'
 220     eqpe(i)     'precio de exportación de los productos i en moneda extranjera'
 221     eqpm(i)     'precio de importación de los productos i en moneda extranjera'
 222     eqepsilon   'balanza de pagos'
 223     eqpqs(i)    'función de Armington para los productos i'
 224     eqM(i)      'importaciones de los productos i'
 225     eqD(i)      'demanda local de los productos i'
 226     eqDs(i)     'sumministro de la demanda local de productos i'
 227     eqpzd(i)    'producción bruta de la función de transformación'
 228     eqE(i)      'exportaciones de los productos i'
 229   
 230     eqAlp(l,h)  'ahorro a largo plazo del factor h por el hogar l'
 231   
 232     eqpqd(i)    'condición de equilibrio del mercado para el producto compuesto de los sectores i'
 233  *   eqpf(h)     'condición de equilibrio del mercado para los factores h'
 234     obj         'utilidad [ficticia]'
 235  ;
 236   
 237  * comercio internacional
 238  eqpe(i)..   pe(i)     =e= epsilon*pWe(i);
 239  eqpm(i)..   pm(i)     =e= epsilon*pWm(i);
 240  eqepsilon.. sum(i, pWe(i) * E(i)) + Sf =e= sum(i, pWm(i) * M(i));
 241  * producción factor compuesto
 242  eqpy(j)..     Y(j)    =e= b(j)*prod(h, F(h,j) ** beta(h,j));
 243  eqF(h,j)..    F(h,j)  =e= beta(h,j) * py(j) * Y(j) / pf(h);
 244  eqX(i,j)..    X(i,j)  =e= ax(i,j) * Z(j);
 245  eqY(j)..      Y(j)    =e= ay(j) * Z(j);
 246  eqpzs(j)..    pz(j)   =e= ay(j)*py(j) + sum(i, ax(i,j) * pq(i));
 247  * gobierno
 248  * Alp paga impuestos
 249  eqTd(l)..     Td(l)   =e= taud(l) * (sum(h, pf(h) * (FF(l,h) + Alp(l,h))) + PssH0(l));
 250  eqTz(j)..     Tz(j)   =e= tauz(j) * pz(j)*Z(j);
 251  eqTm(i)..     Tm(i)   =e= taum(i) * pm(i)*M(i);
 252  eqAgE(i)..    AgE(i)  =e= cage(i) * (sum(n,Td(n)) + sum(j,Tz(j)) + sum(j,Tm(j)));
 253  eqAgH(l)..    AgH(l)  =e= cagh(l) * (sum(n,Td(n)) + sum(j,Tz(j)) + sum(j,Tm(j)));
 254  * ahorro
 255  * No se tienen en cuenta los Alp para el ahorro destinado a inversión
 256  eqSp(l)..     Sp(l)   =e= ssp(l) * (sum(h, pf(h) * FF(l,h)) + PssH0(l));
 257  eqSg..        Sg      =e= ssg * (sum(l,Td(l)) + sum(j,Tz(j)) + sum(j,Tm(j)) - sum(j,AgE(j)) - sum(l,AgH(l)));
 258  eqXg(i)..     Xg(i)   =e= mu(i) * (sum(l,Td(l)) + sum(j,Tz(j)) + sum(j,Tm(j)) - Sg - sum(j,AgE(j)) - sum(l,AgH(l)))/pq(i);
 259  eqctzsse(i).. CssE(i) =e= ctzsse(i) * F['L',i];
 260  * se cotiza a la seguridad social por los Alp
 261  eqctzssh(l).. CssH(l) =e= ctzssh(l) * (FF[l,'L'] + Alp[l,'l']);
 262  * inversión
 263  eqXv(i)..     Xv(i)   =e= lambda(i) * (sum(l,Sp(l)) + Sg + epsilon*Sf) / pq(i);
 264  * consumo de los hogares, con solo las rentas iniciales (FF) sin el Alp
 265  eqXp(l,i)..   Xp(l,i) =e= alpha(l,i) * (sum(h,pf(h) * FF(l,h)) + AgH(l) + PssH0(l) - (Sp(l) + Td(l)+CssH(l))) / pq(i) + DeAd(l,i);
 266  * producto de Armington
 267  eqpqs(i)..   Q(i)     =e=  gamma(i) * (deltam(i) * M(i) ** eta(i) + deltad(i) * D(i) ** eta(i)) ** (1 / eta(i));
 268  eqM(i)..     M(i)     =e= (gamma(i) ** eta(i) * deltam(i) * pq(i) / ((1 + taum(i)) * pm(i))) ** (1 / (1 - eta(i))) * Q(i);
 269  eqD(i)..     D(i)     =e= (gamma(i) ** eta(i) * deltad(i) * pq(i) / pd(i)) ** (1 / (1 - eta(i))) * Q(i);
 270  * función de transformacion CET
 271  eqpzd(i)..   Z(i)     =e=  theta(i) * (xie(i) * E(i) ** phi(i) + xid(i) * D(i) ** phi(i)) ** (1 / phi(i));
 272  eqE(i)..     E(i)     =e= (theta(i) ** phi(i) * xie(i) * (1 + tauz(i) + CssE(i) / Z(i) - AgE(i) / Z(i) + Apz) * pz(i) / pe(i) )** (1 / (1 - phi(i))) * Z(i);
 273  eqDs(i)..    D(i)     =e= (theta(i) ** phi(i) * xid(i) * (1 + tauz(i) + CssE(i) / Z(i) - AgE(i) / Z(i) + Apz) * pz(i) / pd(i)) ** (1 / (1 - phi(i))) * Z(i);
 274   
 275  * el Alp es la diferencia entre las utilizaciones de los sectores (F) y las aportaciones iniciales de los hogares (FF)
 276  eqAlp(l,h).. Alp(l,h) =e= sum(i,F(h,i)) * rf(l,h) - FF(l,h);
 277   
 278  * condición de equilibrio del mercado
 279   
 280  eqpqd(i)..   Q(i)     =e= sum(l, Xp(l,i)) + Xg(i) + Xv(i) + sum(j, X(i,j));
 281  * es redundante, porque hemos definido Alp como la diferencia entre las utilizaciones de los sectores (F) y las aportaciones iniciales de los hogares (FF)
 282  *eqpf(h)..    sum(i,F(h,i)) =e= sum(l,FF(l,h)) + sum(l,Alp(l,h));
 283   
 284  * función objetivo ficticia
 285  *obj..       UU        =e= sum(l, prod(i, Xp(l,i) ** alpha(l,i))) - 100000. * Apz * Apz;
 286  * función objetivo ficticia, con la condición de que el uso de factores sea mínimo (resten lo mínimo)
 287  obj..       UU        =e= sum(l, prod(i, Xp(l,i) ** alpha(l,i))) - 100000. * Apz * Apz - sum(j,F('L',j)) - sum(j,F('K',j));
 288   
 289  * inicialización de variables
 290  Y.l(j)    = Y0(j);
 291  F.l(h,j)  = F0(h,j);
 292  X.l(i,j)  = X0(i,j);
 293  Z.l(j)    = Z0(j);
 294  Xp.l(l,i) = Xp0(l,i);
 295  Xg.l(i)   = Xg0(i);
 296  Xv.l(i)   = Xv0(i);
 297  E.l(i)    = E0(i);
 298  M.l(i)    = M0(i);
 299  Q.l(i)    = Q0(i);
 300  D.l(i)    = D0(i);
 301  pf.l(h)   = 1;
 302  py.l(j)   = 1;
 303  pz.l(j)   = 1;
 304  pq.l(i)   = 1;
 305  pe.l(i)   = 1;
 306  pm.l(i)   = 1;
 307  pd.l(i)   = 1;
 308  epsilon.l = 1;
 309  Sp.l(l)   = Sp0(l);
 310  Sg.l      = Sg0;
 311  Td.l(l)   = Td0(l);
 312  Tz.l(j)   = Tz0(j);
 313  Tm.l(i)   = Tm0(i);
 314  CssH.l(l) = CssH0(l);
 315  CssE.l(i) = CssE0(i);
 316  AgE.l(i)  = AgE0(i);
 317  AgH.l(l)  = AgH0(l);
 318  Alp.l(l,h)= Alp0(l,h);
 319  Apz.l     = 0;
 320   
 321  * cota inferior de las variables, puede eliminar o producir infactibilidad, según el caso
 322  Y.lo(j)     = 0.0000;
 323  F.lo(h,j)   = 0.0000;
 324  X.lo(i,j)   = 0.0000;
 325  Z.lo(j)     = 0.0000;
 326  Xp.lo(l,i)  = 0.0000;
 327  Xg.lo(i)    = 0.0000;
 328  Xv.lo(i)    = 0.0000;
 329  E.lo(i)     = 0.0000;
 330  M.lo(i)     = 0.0000;
 331  Q.lo(i)     = 0.0000;
 332  D.lo(i)     = 0.0000;
 333  pf.lo(h)    = 0.0000;
 334  py.lo(j)    = 0.0000;
 335  pz.lo(j)    = 0.0000;
 336  pq.lo(i)    = 0.0000;
 337  pe.lo(i)    = 0.0000;
 338  pm.lo(i)    = 0.0000;
 339  pd.lo(i)    = 0.0000;
 340  epsilon.lo  = 0.0000;
 341  Sp.lo(l)    = 0.0000;
 342  Sg.lo       = 0.0000;
 343  Td.lo(l)    = 0.0000;
 344  Tz.lo(j)    = 0.0000;
 345  Tm.lo(i)    = 0.0000;
 346  CssH.lo(l)  = 0.0000;
