 378  ;
 379   
 380  UU0(l) = prod(i, Xp0(l,i)**alpha(l,i));
 381  ep0(l) = UU0(l) /prod(i, (alpha(l,i)/1)**alpha(l,i));
 382  ep1(l) = (prod(i,Xp.l(l,i)**alpha(l,i))) / prod(i, (alpha(l,i)/1)**alpha(l,i));
 383  EV(l)  = ep1(l) - ep0(l);
 384   
