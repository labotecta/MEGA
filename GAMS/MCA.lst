1481     ep0(l) 'gasto en el equilibrio de base'
1482     ep1(l) 'gasto en el equilibrio del nuevo escenario'
1483     EV(l)  'variación equivalente de Hicksian'
1484  ;
1485   
1486  UU0(l) = prod(i, Xp0(l,i)**alpha(l,i));
1487  ep0(l) = UU0(l) /prod(i, (alpha(l,i)/1)**alpha(l,i));
1488  ep1(l) = (prod(i,Xp.l(l,i)**alpha(l,i))) / prod(i, (alpha(l,i)/1)**alpha(l,i));
1489  EV(l)  = ep1(l) - ep0(l);
1490   
1491  display EV;
