 723   
 724  * bienestar económico
 725  Parameter
 726     UU0(l) 'nivel de utilidad en el equilibrio de base'
 727     ep0(l) 'gasto en el equilibrio de base'
 728     ep1(l) 'gasto en el equilibrio del nuevo escenario'
 729     EV(l)  'variación equivalente de Hicksian'
 730  ;
 731   
 732  UU0(l) = prod(i, Xp0(l,i)**alpha(l,i));
 733  ep0(l) = UU0(l) /prod(i, (alpha(l,i)/1)**alpha(l,i));
 734  ep1(l) = (prod(i,Xp.l(l,i)**alpha(l,i))) / prod(i, (alpha(l,i)/1)**alpha(l,i));
 735  EV(l)  = ep1(l) - ep0(l);
 736   
 737  display EV;
