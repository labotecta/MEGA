  53   
  54  * cargando los valores iniciales
  55  Parameter
  56     Y0(j)     'factor compuesto de las empresas j'
  57     F0(h,j)   'los factores h empleados por las empresas j'
  58     X0(i,j)   'inputs intermedios'
  59     Z0(j)     'producción de las empresas j'
  60     Xp0(l,i)  'consumo de los hogares l de los productos i'
  61     Xg0(i)    'consumo del gobierno del producto i'
  62     Xv0(i)    'demanda de inversión de la empresa i'
  63     E0(i)     'exportaciones de las empresas i'
  64     M0(i)     'importaciones de las empresas i'
  65     Q0(i)     "producto compuesto de Armington de las empresas i"
  66     D0(i)     'consumo domestico de los productos i'
  67     Sp0(l)    'ahorro de los hogares l'
  68     Sg0       'ahorro del gobierno'
  69     Td0(l)    'impuestos a los hogares l'
  70     Tz0(j)    'impuestos a las producciones j'
  71     Tm0(j)    'aranceles a los productos j'
  72     FF(l,h)   'factores h prestados por los hogares l'
  73     Sf        'ahorro exterior en moneda local'
  74     CssH0(l)  'pagos a la seguridad social de los hogares l'
  75     CssE0(i)  'pagos a la seguridad social de las empresas i'
  76     PssH0(l)  'pensiones de los hogares l'
  77     AgE0(i)   'ayudas del gobierno a las empresas i'
  78     AgH0(l)   'ayudas del gobierno a los hogares l'
  79     pWe(i)    'precio de exportación en moneda local'
  80     pWm(i)    'precio de importación en moneda local'
  81     tauz(i)   'tasa de impuestos a las producciones j'
  82     taum(i)   'tasa de aranceles a los productos j'
  83     ctzsse(i) 'tasa de la seg.social a las empresas i'
  84     ctzssh(l) 'tasa de la seg.social a los hogares l'
  85  ;
  86  Td0(l)   = SAM("SP",l)+SAM("INP",l);
  87  Tz0(j)   = SAM("INP",j);
  88  Tm0(j)   = 0.000001;
  89  F0(h,j)  = SAM(h,j);
  90  Y0(j)    = sum(h, F0(h,j));
  91  X0(i,j)  = SAM(i,j);
  92  Z0(j)    = Y0(j) +sum(i, X0(i,j));
  93  M0(i)    = SAM("SE",i);
  94  CssE0(i) = SAM("CSS",i);
  95  CssH0(l) = SAM("CSS",l);
  96  PssH0(l) = SAM(l,"CSS");
  97  AgE0(i)  = SAM(i,'AYD');
  98  AgH0(l)  = SAM(l,'AYD');
  99  tauz(j)$(Z0(j) eq 0)  = 0.;
 100  tauz(j)$(Z0(j) ne 0)  = Tz0(j)/Z0(j);
 101  taum(j)$(M0(j) eq 0)  = 0.;
 102  taum(j)$(M0(j) ne 0)  = Tm0(j)/M0(j);
 103  Xp0(l,i) = SAM(i,l);
 104  FF(l,h)  = SAM(l,h);
 105  Xg0(i)   = SAM(i,"SP");
 106  Xv0(i)   = SAM(i,"A-I");
 107  E0(i)    = SAM(i,"SE");
 108  Q0(i)    = sum(l, Xp0(l,i))+Xg0(i)+Xv0(i)+sum(j, X0(i,j));
 109  D0(i)    = (1+tauz(i))*Z0(i)-E0(i)+CssE0(i)-AgE0(i);
 110  Sp0(l)   = SAM("A-I",l);
 111  Sg0      = SAM("A-I","SP");
 112  Sf       = SAM("A-I","SE");
 113  ctzsse(i) = CssE0(i)/F0('L',i);
 114  ctzssh(l)$(FF(l,'L')+PssH0(l) eq 0) = 0.;
 115  ctzssh(l)$(FF(l,'L')+PssH0(l) ne 0) = CssH0(l)/(FF(l,'L')+PssH0(l));
 116  pWe(i)   = 1;
 117  pWm(i)   = 1;
 118   
 119  display FF,F0,Y0,X0,Xp0,Xg0,Xv0,Q0,Z0,E0,M0,D0,Tz0,Tm0,Sp0,Td0,AgE0,AgH0,Sg0,Sf,
 120          CssE0,CssH0,PssH0;
 121   
 122  * calibrado
 123  Parameter
 124     sigma(i) 'elasticidad de sustitución (importación) de los sectores i'
 125     psi(i)   'elasticidad de transformación entre local y exportación (CET) de los sectores i'
 126     eta(i)   'parámetro de elasticidad de sustitución  de los sectores i'
 127     phi(i)   'parámetro de elasticidad de transformación de los sectores i';
 128   
 129  sigma(i) =  2;
 130  psi(i)   =  2;
 131  eta(i)   = (sigma(i) - 1)/sigma(i);
 132  phi(i)   = (psi(i) + 1)/psi(i);
 133   
 134  Parameter
 135     alpha(l,i) 'participación de los productos i en la función de utilidad de los hogares l'
 136     beta(h,j)  'participación de los factores h en la función de producción de las empresas j'
 137     b(j)       'parámetro de eswcala de la función de producción de las empresas j'
 138     ax(i,j)    'coeficietes de los imputs intermedios'
 139     ay(j)      'coeficiente del input de factor compuesto para las empresas j'
 140     mu(i)      'participación del producto i en el consumo del gobierno'
 141     lambda(i)  'participación en la demanda de inversión de las empresas i'
 142     deltam(i)  'participación de la importación de productos i en la función de Armington'
 143     deltad(i)  'participación de la producción local de productos i en la función de Armington'
 144     gamma(i)   'parámetro de escala de la función de producción de Armington de las empresas i'
 145     xid(i)     'coeficiente de participación en la CET de la demanda local de los sectores i'
 146     xie(i)     'coeficiente de participación en la CET de la exportación de los sectores i'
 147     theta(i)   'coeficiente de escala de la CET de exportación de los sectores i'
 148     ssp(l)     'apropensión al ahorro de los hogares l'
 149     ssg        'propensión al ahorro del gobierno'
 150     taud(l)    'tasa de impuestos directos a los hogares l'
 151     cage(i)    'coeficiente de las ayudas del gobierno a las empresas i'
 152     cagh(l)    'coeficiente de las ayudas del gobierno a los hogares l'
 153     alpha_c(l,i)'copia de alpha'
 154     beta_c(h,j) 'copia'
 155  ;
 156  alpha(l,i)  =  Xp0(l,i)/sum(j, Xp0(l,j));
 157  beta(h,j)   =  F0(h,j)/sum(k, F0(k,j));
 158  b(j)        =  Y0(j)/prod(h, F0(h,j)**beta(h,j));
 159  ax(i,j)     =  X0(i,j)/Z0(j);
 160  ay(j)       =  Y0(j)/Z0(j);
 161  mu(i)       =  Xg0(i)/sum(j, Xg0(j));
 162  lambda(i)   =  Xv0(i)/(sum(l,Sp0(l))+Sg0+Sf);
 163  deltam(i)   = (1+taum(i))*M0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 164  deltad(i)   =  D0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 165  gamma(i)    =  Q0(i)/(deltam(i)*M0(i)**eta(i)+deltad(i)*D0(i)**eta(i))**(1/eta(i));
 166  xie(i)      =  E0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 167  xid(i)      =  D0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 168  theta(i)    =  Z0(i)/(xie(i)*E0(i)**phi(i)+xid(i)*D0(i)**phi(i))**(1/phi(i));
 169  ssp(l)$((sum(h, FF(l,h))+ PssH0(l)) eq 0) = 0.;
 170  ssp(l)$((sum(h, FF(l,h))+ PssH0(l)) ne 0) = Sp0(l)/(sum(h, FF(l,h))+ PssH0(l));
 171  ssg         =  Sg0/(sum(l,Td0(l))+sum(j,Tz0(j))+sum(j,Tm0(j))-sum(j,AgE0(j))-sum(l,AgH0(l)));
 172  taud(l)$((sum(h, FF(l,h))+ PssH0(l)) eq 0) = 0.;
 173  taud(l)$((sum(h, FF(l,h))+ PssH0(l)) ne 0) = Td0(l)/(sum(h, FF(l,h))+ PssH0(l));
 174  cage(i)     = AgE0(i) / (sum(n,Td0(n)) + sum(j,Tz0(j)) + sum(j,Tm0(j)));
 175  cagh(l)     = AgH0(l) / (sum(n,Td0(n)) + sum(j,Tz0(j)) + sum(j,Tm0(j)));
 176   
 177  alpha_c(l,i)=alpha(l,i);
 178  beta_c(h,j) =beta(h,j)
 179   
 180  display phi,tauz,taum,alpha,beta,b,ax,ay,mu,lambda,deltam,deltad,gamma,xie,xid,
 181          theta,ssp,ssg,taud,ctzsse,ctzssh,cage,cagh;
 182   
 183  Variable
 184     Y(j)     'factor compuesto de los sectores i'
 185     F(h,i)   'uso de los factores h por los sectores i'
 186     X(i,j)   'consumo intermedio de los productos i por los sectores j'
 187     Z(i)     'producción bruta de los sectores i'
 188     Xp(l,i)  'demanda de los hogares l del producto i'
 189     Xg(i)    'demanda del gobierno de los productos i'
 190     Xv(i)    'demanda de inversión de los sectores i'
 191     E(i)     'exportaciones de los productos i'
 192     M(i)     'importaciones de los productos i'
 193     Q(i)     "producción del producto compuesto de Armington por los sectores i"
 194     D(i)     'demanda local de los productos i'
 195     pf(h)    'precio de los factores h'
 196     py(i)    'precio de los factores compuestos i'
 197     pz(i)    'precio de producir los productos locales i'
 198     pq(i)    "precio de los productos compuesto de Armington i"
 199     pe(i)    'precio de exportación de los productos i en moneda local'
 200     pm(i)    'precio de importación de los productos i en moneda local'
 201     pd(i)    'precio de los productos i para los compradores locales'
 202     epsilon  'cotización: moneda local/ moneda extranjera'
 203     Sp(l)    'ahorro de los hogares l'
 204     Sg       'ahorro del gobierno'
 205     Td(l)    'impuestos directos a los hogares l'
 206     Tz(i)    'impuesto a la producción de los sectores i'
 207     Tm(i)    'arancel de importación para los productos i'
 208     CssH(l)  'pagos a la seguridad social de los hogares l'
 209     CssE(i)  'pagos a la seguridad social de las empresas i'
 210     AgE(i)   'ayudas del gobierno a las empresas i'
 211     AgH(l)   'ayudas del gobierno a los hogares l'
 212     Apz      'holgura de los pseudo impuestos CssE CssH AgE AgH sobre Z'
 213     UU       'utilidad [ficticia]'
 214  ;
 215   
 216  Equation
 217     eqpy(i)     'producción del factor compuesto de los sectores i'
 218     eqF(h,j)    'uso de los factores h por los sectores i'
 219     eqX(i,j)    'consumo intermedio de los productos i por los sectores j'
 220     eqY(i)      'demanda del factor compuesto de los sectores i'
 221     eqpzs(i)    'coste unitario de producción de los sectores i'
 222     eqTd(l)     'impuestos directos a los hogares l'
 223     eqTz(i)     'impuesto a la producción de los sectores i'
 224     eqTm(i)     'arancel de importación para los productos i'
 225     eqAgE(i)    'ayudas del gobierno a las empresas i'
 226     eqAgH(l)    'ayudas del gobierno a los hogares l'
 227     eqSp(l)     'ahorro de los hogares l'
 228     eqSg        'ahorro del gobierno'
 229     eqctzsse(i) 'cotización seg social de las empresas i'
 230     eqctzssh(l) 'cotización seg social de los hogares l'
 231     eqXg(i)     'demanda del gobierno de los productos i'
 232     eqXv(i)     'demanda de inversión de los sectores i'
 233     eqXp(l,i)   'demanda de los hogares l del producto i'
 234     eqpe(i)     'precio de exportación de los productos i en moneda extranjera'
 235     eqpm(i)     'precio de importación de los productos i en moneda extranjera'
 236     eqepsilon   'balanza de pagos'
 237     eqpqs(i)    'función de Armington para los productos i'
 238     eqM(i)      'importaciones de los productos i'
 239     eqD(i)      'domestic good demand function'
 240     eqpzd(i)    'transformation function'
 241     eqDs(i)     'demanda local de los productos i'
 242     eqE(i)      'exportaciones de los productos i'
 243     eqpqd(i)    'condición de equilibrio del mercado para el producto compuesto de los sectores i'
 244     eqpf(h)     'condición de equilibrio del mercado para los factores h'
 245     obj         'utilidad [ficticia]'
 246  ;
 247   
 248  * comercio internacional
 249  eqpe(i)..   pe(i)     =e= epsilon*pWe(i);
 250   
 251  eqpm(i)..   pm(i)     =e= epsilon*pWm(i);
 252   
 253  eqepsilon.. sum(i, pWe(i)*E(i)) + Sf =e= sum(i, pWm(i)*M(i));
 254   
 255  * producción local
 256  eqpy(j)..     Y(j)    =e= b(j)*prod(h, F(h,j)**beta(h,j));
 257   
 258  eqF(h,j)..    F(h,j)  =e= beta(h,j)*py(j)*Y(j)/pf(h);
 259   
 260  eqX(i,j)..    X(i,j)  =e= ax(i,j)*Z(j);
 261   
 262  eqY(j)..      Y(j)    =e= ay(j)*Z(j);
 263   
 264  eqpzs(j)..    pz(j)   =e= ay(j)*py(j)+sum(i, ax(i,j)*pq(i));
 265   
 266  * gobierno
 267  eqTd(l)..     Td(l)   =e= taud(l) * (sum(h, pf(h)*FF(l,h))+PssH0(l));
 268   
 269  eqTz(j)..     Tz(j)   =e= tauz(j)*pz(j)*Z(j);
 270   
 271  eqTm(i)..     Tm(i)   =e= taum(i)*pm(i)*M(i);
 272   
 273  eqAgE(i)..    AgE(i)  =e= cage(i) * (sum(n,Td(n))+sum(j,Tz(j))+sum(j,Tm(j)));
 274   
 275  eqAgH(l)..    AgH(l)  =e= cagh(l) * (sum(n,Td(n))+sum(j,Tz(j))+sum(j,Tm(j)));
 276   
 277  * ahorro
 278  eqSp(l)..     Sp(l)   =e= ssp(l) * (sum(h, pf(h)*FF(l,h))+PssH0(l));
 279   
 280  eqSg..        Sg      =e= ssg*(sum(l,Td(l))+sum(j,Tz(j))+sum(j,Tm(j))-sum(j,AgE(j))-sum(l,AgH(l)));
 281   
 282  eqXg(i)..     Xg(i)   =e= mu(i)   * (sum(l,Td(l))+sum(j,Tz(j))+sum(j,Tm(j))-Sg-sum(j,AgE(j))-sum(l,AgH(l)))/pq(i);
 283   
 284  eqctzsse(i).. CssE(i) =e= ctzsse(i) * F['L',i];
 285   
 286  eqctzssh(l).. CssH(l) =e= ctzssh(l) * (FF[l,'L'] + PssH0(l));
 287   
 288  * inversión
 289  eqXv(i)..     Xv(i)   =e= lambda(i)*(sum(l,Sp(l)) + Sg + epsilon*Sf)/pq(i);
 290   
 291  * consumo de los hogares
 292  eqXp(l,i)..   Xp(l,i) =e= alpha(l,i) * (sum(h,pf(h)*FF(l,h))+AgH(l)+PssH0(l)-(Sp(l)+Td(l)+CssH(l)))/pq(i);
 293   
 294  * producto de Armington
 295  eqpqs(i)..  Q(i)      =e=  gamma(i)*(deltam(i)*M(i)**eta(i) + deltad(i)*D(i)**eta(i))**(1/eta(i));
 296   
 297  eqM(i)..    M(i)      =e= (gamma(i)**eta(i)*deltam(i)*pq(i)/((1+taum(i))*pm(i)))**(1/(1-eta(i)))*Q(i);
 298   
 299  eqD(i)..    D(i)      =e= (gamma(i)**eta(i)*deltad(i)*pq(i)/pd(i))**(1/(1-eta(i)))*Q(i);
 300   
 301  * función de transformacion CET
 302  eqpzd(i)..  Z(i)      =e=  theta(i)*(xie(i)*E(i)**phi(i)+xid(i)*D(i)**phi(i))**(1/phi(i));
 303   
 304  eqE(i)..    E(i)      =e= (theta(i)**phi(i)*xie(i)*(1+tauz(i)+CssE(i)/Z(i)-AgE(i)/Z(i)+Apz)*pz(i)/pe(i))**(1/(1-phi(i)))*Z(i);
 305   
 306  eqDs(i)..   D(i)      =e= (theta(i)**phi(i)*xid(i)*(1+tauz(i)+CssE(i)/Z(i)-AgE(i)/Z(i)+Apz)*pz(i)/pd(i))**(1/(1-phi(i)))*Z(i);
 307   
 308  * condición de equilibrio del mercado
 309  eqpqd(i)..  Q(i)      =e= sum(l, Xp(l,i)) + Xg(i) + Xv(i) + sum(j, X(i,j));
 310   
 311  eqpf(h)..   sum(j, F(h,j)) =e= sum(l,FF(l,h));
 312   
 313  * función objetivo ficticia
 314  obj..       UU        =e= sum(l, prod(i, Xp(l,i)**alpha(l,i)))-100000.*Apz*Apz;
 315   
 316  * inicialización de variables
 317  Y.l(j)    = Y0(j);
 318  F.l(h,j)  = F0(h,j);
 319  X.l(i,j)  = X0(i,j);
 320  Z.l(j)    = Z0(j);
 321  Xp.l(l,i) = Xp0(l,i);
 322  Xg.l(i)   = Xg0(i);
 323  Xv.l(i)   = Xv0(i);
 324  E.l(i)    = E0(i);
 325  M.l(i)    = M0(i);
 326  Q.l(i)    = Q0(i);
 327  D.l(i)    = D0(i);
 328  pf.l(h)   = 1;
 329  py.l(j)   = 1;
 330  pz.l(j)   = 1;
 331  pq.l(i)   = 1;
 332  pe.l(i)   = 1;
 333  pm.l(i)   = 1;
 334  pd.l(i)   = 1;
 335  epsilon.l = 1;
 336  Sp.l(l)   = Sp0(l);
 337  Sg.l      = Sg0;
 338  Td.l(l)   = Td0(l);
 339  Tz.l(j)   = Tz0(j);
 340  Tm.l(i)   = Tm0(i);
 341  CssH.l(l) = CssH0(l);
 342  CssE.l(i) = CssE0(i);
 343  AgE.l(i)  = AgE0(i);
 344  AgH.l(l)  = AgH0(l);
 345  Apz.l     = 0.0;
 346   
 347  * cota inferior de las variables, puede eliminar o producir infactibilidad, según el caso
 348  Y.lo(j)     = 0.0000;
 349  F.lo(h,j)   = 0.0000;
 350  X.lo(i,j)   = 0.0000;
 351  Z.lo(j)     = 0.0000;
 352  Xp.lo(l,i)  = 0.0000;
 353  Xg.lo(i)    = 0.0000;
 354  Xv.lo(i)    = 0.0000;
 355  E.lo(i)     = 0.0000;
 356  M.lo(i)     = 0.0000;
 357  Q.lo(i)     = 0.0000;
 358  D.lo(i)     = 0.0000;
 359  pf.lo(h)    = 0.0000;
 360  py.lo(j)    = 0.0000;
 361  pz.lo(j)    = 0.0000;
