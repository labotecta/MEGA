GAMS 51.1.0  2d039df5 Sep 13, 2025          WEX-WEI x86 64bit/MS Windows - 12/12/25 16:10:49 Page 1
Modelo ampliado con MCS: MCA-ESP-05
C o m p i l a t i o n


   2   
      basado en el libro:
      Handbook of Computible General Equilibrium Modeling
      Hosoe, N, Gasawa, K, and Hashimoto, H
      University of Tokyo Press, Tokyo, Japan, 2004
   9   
  10  Set
  11     u      'cuentas de la MCS'  / AP1, AP2, AP3, AP4, AP5, AP6, L, K, C1, C2, A-I, CSS, INP, SP, SE, AYD /
  12     i(u)   'sectores'           / AP1, AP2, AP3, AP4, AP5, AP6                                           /
  13     h(u)   'factores'           /                               L, K                                     /
  14     l(u)   'hogares'            /                                     C1, C2                             /;
  15   
  16  Alias (u,v), (i,j), (h,k), (l,n);
  17   
  18  Parameter SAM(u,v);
  30   
  31  display SAM;
  32   
  33  * cargando los valores iniciales
  34  Parameter
  35     Y0(j)     'factor compuesto de las empresas j'
  36     F0(h,j)   'los factores h empleados por las empresas j'
  37     FF0(l,h)  'factores h prestados por los hogares l'
  38     X0(i,j)   'inputs intermedios'
  39     Z0(j)     'producción de las empresas j'
  40     Xp0(l,i)  'consumo de los hogares l de los productos i'
  41     Xg0(i)    'consumo del gobierno del producto i'
  42     Xv0(i)    'demanda de inversión de la empresa i'
  43     E0(i)     'exportaciones de las empresas i'
  44     M0(i)     'importaciones de las empresas i'
  45     Q0(i)     "producto compuesto de Armington de las empresas i"
  46     D0(i)     'consumo domestico de los productos i'
  47     Sp0(l)    'ahorro de los hogares l'
  48     Sg0       'ahorro del gobierno'
  49     Td0(l)    'impuestos a los hogares l'
  50     Tz0(j)    'impuestos a las producciones j'
  51     Tm0(j)    'aranceles a los productos j'
  52     Sf        'ahorro exterior en moneda local'
  53     CssH0(l)  'pagos a la seguridad social de los hogares l'
  54     CssE0(i)  'pagos a la seguridad social de las empresas i'
  55     PssH0(l)  'pensiones de los hogares l'
  56     AgE0(i)   'ayudas del gobierno a las empresas i'
  57     AgH0(l)   'ayudas del gobierno a los hogares l'
  58     pWe(i)    'precio de exportación en moneda local'
  59     pWm(i)    'precio de importación en moneda local'
  60     tauz(i)   'tasa de impuestos a las producciones j'
  61     taum(i)   'tasa de aranceles a los productos j'
  62     ctzsse(i) 'tasa de la seg.social a las empresas i'
  63     ctzssh(l) 'tasa de la seg.social a los hogares l'
  64     DeAd(l,i)
  65  ;
  66  Td0(l)   = SAM("SP",l)+SAM("INP",l);
  67  Tz0(j)   = SAM("INP",j);
  68  Tm0(j)   = 0.000001;
  69  F0(h,j)  = SAM(h,j);
  70  FF0(l,h) = SAM(l,h);
  71  Y0(j)    = sum(h, F0(h,j));
  72  X0(i,j)  = SAM(i,j);
  73  Z0(j)    = Y0(j) +sum(i, X0(i,j));
  74  M0(i)    = SAM("SE",i);
  75  CssE0(i) = SAM("CSS",i);
  76  CssH0(l) = SAM("CSS",l);
  77  PssH0(l) = SAM(l,"CSS");
  78  AgE0(i)  = SAM(i,'AYD');
  79  AgH0(l)  = SAM(l,'AYD');
  80  tauz(j)$(Z0(j) eq 0)  = 0.;
  81  tauz(j)$(Z0(j) ne 0)  = Tz0(j)/Z0(j);
  82  taum(j)$(M0(j) eq 0)  = 0.;
  83  taum(j)$(M0(j) ne 0)  = Tm0(j)/M0(j);
  84  Xp0(l,i) = SAM(i,l);
  85  Xg0(i)   = SAM(i,"SP");
  86  Xv0(i)   = SAM(i,"A-I");
  87  E0(i)    = SAM(i,"SE");
  88  Q0(i)    = sum(l, Xp0(l,i))+Xg0(i)+Xv0(i)+sum(j, X0(i,j));
  89  D0(i)    = (1+tauz(i))*Z0(i)-E0(i)+CssE0(i)-AgE0(i);
  90  Sp0(l)   = SAM("A-I",l);
  91  Sg0      = SAM("A-I","SP");
  92  Sf       = SAM("A-I","SE");
  93  ctzsse(i) = CssE0(i)/F0('L',i);
  94  ctzssh(l)$(FF0(l,'L') eq 0) = 0.;
  95  ctzssh(l)$(FF0(l,'L') ne 0) = CssH0(l)/FF0(l,'L');
  96  pWe(i)   = 1;
  97  pWm(i)   = 1;
  98  DeAd(l,i) = 0;
  99   
 100  display FF0,F0,Y0,X0,Xp0,Xg0,Xv0,Q0,Z0,E0,M0,D0,Tz0,Tm0,Sp0,Td0,AgE0,AgH0,Sg0,Sf,
 101          CssE0,CssH0,PssH0,DeAd;
 102   
 103  * calibrado
 104  Parameter
 105     sigma(i) 'elasticidad de sustitución (importación) de los sectores i'
 106     psi(i)   'elasticidad de transformación entre local y exportación (CET) de los sectores i'
 107     eta(i)   'parámetro de elasticidad de sustitución  de los sectores i'
 108     phi(i)   'parámetro de elasticidad de transformación de los sectores i';
 109   
 110  sigma(i) =  2;
 111  psi(i)   =  2;
 112  eta(i)   = (sigma(i) - 1)/sigma(i);
 113  phi(i)   = (psi(i) + 1)/psi(i);
 114   
 115  Parameter
 116     alpha(l,i) 'participación de los productos i en la función de utilidad de los hogares l'
 117     beta(h,j)  'participación de los factores h en la función de producción de las empresas j'
 118     b(j)       'parámetro de eswcala de la función de producción de las empresas j'
 119     ax(i,j)    'coeficietes de los imputs intermedios'
 120     ay(j)      'coeficiente del input de factor compuesto para las empresas j'
 121     mu(i)      'participación del producto i en el consumo del gobierno'
 122     lambda(i)  'participación en la demanda de inversión de las empresas i'
 123     deltam(i)  'participación de la importación de productos i en la función de Armington'
 124     deltad(i)  'participación de la producción local de productos i en la función de Armington'
 125     gamma(i)   'parámetro de escala de la función de producción de Armington de las empresas i'
 126     xid(i)     'coeficiente de participación en la CET de la demanda local de los sectores i'
 127     xie(i)     'coeficiente de participación en la CET de la exportación de los sectores i'
 128     theta(i)   'coeficiente de escala de la CET de exportación de los sectores i'
 129     ssp(l)     'apropensión al ahorro de los hogares l'
 130     ssg        'propensión al ahorro del gobierno'
 131     taud(l)    'tasa de impuestos directos a los hogares l'
 132     cage(i)    'coeficiente de las ayudas del gobierno a las empresas i'
 133     cagh(l)    'coeficiente de las ayudas del gobierno a los hogares l'
 134     alpha_c(l,i)'copia de alpha'
 135     beta_c(h,j) 'copia'
 136  ;
 137  alpha(l,i)  =  Xp0(l,i)/sum(j, Xp0(l,j));
 138  beta(h,j)   =  F0(h,j)/sum(k, F0(k,j));
 139  b(j)        =  Y0(j)/prod(h, F0(h,j)**beta(h,j));
 140  ax(i,j)     =  X0(i,j)/Z0(j);
 141  ay(j)       =  Y0(j)/Z0(j);
 142  mu(i)       =  Xg0(i)/sum(j, Xg0(j));
 143  lambda(i)   =  Xv0(i)/(sum(l,Sp0(l))+Sg0+Sf);
 144  deltam(i)   = (1+taum(i))*M0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 145  deltad(i)   =  D0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 146  gamma(i)    =  Q0(i)/(deltam(i)*M0(i)**eta(i)+deltad(i)*D0(i)**eta(i))**(1/eta(i));
 147  xie(i)      =  E0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 148  xid(i)      =  D0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 149  theta(i)    =  Z0(i)/(xie(i)*E0(i)**phi(i)+xid(i)*D0(i)**phi(i))**(1/phi(i));
 150  ssp(l)$((sum(h, FF0(l,h)) + PssH0(l)) eq 0) = 0.;
 151  ssp(l)$((sum(h, FF0(l,h)) + PssH0(l)) ne 0) = Sp0(l)/(sum(h, FF0(l,h))+ PssH0(l));
 152  ssg         =  Sg0/(sum(l,Td0(l))+sum(j,Tz0(j))+sum(j,Tm0(j))-sum(j,AgE0(j))-sum(l,AgH0(l)));
 153  taud(l)$((sum(h, FF0(l,h)) + PssH0(l)) eq 0) = 0.;
 154  taud(l)$((sum(h, FF0(l,h)) + PssH0(l)) ne 0) = Td0(l)/(sum(h, FF0(l,h))+ PssH0(l));
 155  cage(i)     = AgE0(i) / (sum(n,Td0(n)) + sum(j,Tz0(j)) + sum(j,Tm0(j)));
 156  cagh(l)     = AgH0(l) / (sum(n,Td0(n)) + sum(j,Tz0(j)) + sum(j,Tm0(j)));
 157   
 158  alpha_c(l,i)=alpha(l,i);
 159  beta_c(h,j) =beta(h,j)
 160   
 161  display phi,tauz,taum,alpha,beta,b,ax,ay,mu,lambda,deltam,deltad,gamma,xie,xid,
 162          theta,ssp,ssg,taud,ctzsse,ctzssh,cage,cagh;
 163   
 164  Variable
 165     Y(j)     'factor compuesto de los sectores i'
 166     F(h,i)   'uso de los factores h por los sectores i'
 167     X(i,j)   'consumo intermedio de los productos i por los sectores j'
 168     Z(i)     'producción bruta de los sectores i'
 169     Xp(l,i)  'demanda de los hogares l del producto i'
 170     Xg(i)    'demanda del gobierno de los productos i'
 171     Xv(i)    'demanda de inversión de los sectores i'
 172     E(i)     'exportaciones de los productos i'
 173     M(i)     'importaciones de los productos i'
 174     Q(i)     "producción del producto compuesto de Armington por los sectores i"
 175     D(i)     'demanda local de los productos i'
 176     pf(h)    'precio de los factores h'
 177     py(i)    'precio de los factores compuestos i'
 178     pz(i)    'precio de producir los productos locales i'
 179     pq(i)    "precio de los productos compuesto de Armington i"
 180     pe(i)    'precio de exportación de los productos i en moneda local'
 181     pm(i)    'precio de importación de los productos i en moneda local'
 182     pd(i)    'precio de los productos i para los compradores locales'
 183     epsilon  'cotización: moneda local/ moneda extranjera'
 184     Sp(l)    'ahorro de los hogares l'
 185     Sg       'ahorro del gobierno'
 186     Td(l)    'impuestos directos a los hogares l'
 187     Tz(i)    'impuesto a la producción de los sectores i'
 188     Tm(i)    'arancel de importación para los productos i'
 189     CssH(l)  'pagos a la seguridad social de los hogares l'
 190     CssE(i)  'pagos a la seguridad social de las empresas i'
 191     AgE(i)   'ayudas del gobierno a las empresas i'
 192     AgH(l)   'ayudas del gobierno a los hogares l'
 193     FF(l,h)  'aportación de factores h por los hogares l'
 194     Apz      'holgura de los pseudo impuestos CssE CssH AgE AgH sobre Z'
 195     UU       'utilidad [ficticia]'
 196  ;
 197   
 198  Equation
 199     eqpy(i)     'producción del factor compuesto de los sectores i'
 200     eqF(h,j)    'uso de los factores h por los sectores i'
 201     eqX(i,j)    'consumo intermedio de los productos i por los sectores j'
 202     eqY(i)      'demanda del factor compuesto por los sectores i'
 203     eqpzs(i)    'precio (coste unitario) de la producción bruta de los sectores i'
 204     eqTd(l)     'impuestos directos a los hogares l'
 205     eqTz(i)     'impuesto a la producción de los sectores i'
 206     eqTm(i)     'arancel de importación para los productos i'
 207     eqAgE(i)    'ayudas del gobierno a las empresas i'
 208     eqAgH(l)    'ayudas del gobierno a los hogares l'
 209     eqSp(l)     'ahorro de los hogares l'
 210     eqSg        'ahorro del gobierno'
 211     eqctzsse(i) 'cotización seg social de las empresas i'
 212     eqctzssh(l) 'cotización seg social de los hogares l'
 213     eqXg(i)     'demanda del gobierno de los productos i'
 214     eqXv(i)     'demanda de inversión de los sectores i'
 215     eqXp(l,i)   'demanda de los hogares l del producto i'
 216     eqpe(i)     'precio de exportación de los productos i en moneda extranjera'
 217     eqpm(i)     'precio de importación de los productos i en moneda extranjera'
 218     eqepsilon   'balanza de pagos'
 219     eqpqs(i)    'función de Armington para los productos i'
 220     eqM(i)      'importaciones de los productos i'
 221     eqD(i)      'demanda local de los productos i'
 222     eqDs(i)     'sumministro de la demanda local de productos i'
 223     eqpzd(i)    'producción bruta de la función de transformación'
 224     eqE(i)      'exportaciones de los productos i'
 225     eqFF(l,h)   'aportación de factores h por los hogares l'
 226     eqpqd(i)    'condición de equilibrio del mercado para el producto compuesto de los sectores i'
 227     eqpf(h)     'condición de equilibrio del mercado para los factores h'
 228     obj         'utilidad [ficticia]'
 229  ;
 230   
 231  * comercio internacional
 232  eqpe(i)..   pe(i)     =e= epsilon*pWe(i);
 233  eqpm(i)..   pm(i)     =e= epsilon*pWm(i);
 234  eqepsilon.. sum(i, pWe(i) * E(i)) + Sf =e= sum(i, pWm(i) * M(i));
 235  * producción factor compuesto
 236  eqpy(j)..     Y(j)    =e= b(j)*prod(h, F(h,j) ** beta(h,j));
 237  eqF(h,j)..    F(h,j)  =e= beta(h,j) * py(j) * Y(j) / pf(h);
 238  eqX(i,j)..    X(i,j)  =e= ax(i,j) * Z(j);
 239  eqY(j)..      Y(j)    =e= ay(j) * Z(j);
 240  eqpzs(j)..    pz(j)   =e= ay(j)*py(j) + sum(i, ax(i,j) * pq(i));
 241  * gobierno
 242  eqTd(l)..     Td(l)   =e= taud(l) * (sum(h, pf(h) * (FF(l,h))) + PssH0(l));
 243  eqTz(j)..     Tz(j)   =e= tauz(j) * pz(j)*Z(j);
 244  eqTm(i)..     Tm(i)   =e= taum(i) * pm(i)*M(i);
 245  eqAgE(i)..    AgE(i)  =e= cage(i) * (sum(n,Td(n)) + sum(j,Tz(j)) + sum(j,Tm(j)));
 246  eqAgH(l)..    AgH(l)  =e= cagh(l) * (sum(n,Td(n)) + sum(j,Tz(j)) + sum(j,Tm(j)));
 247  * ahorro
 248  eqSp(l)..     Sp(l)   =e= ssp(l) * (sum(h, pf(h) * FF(l,h)) + PssH0(l));
 249  eqSg..        Sg      =e= ssg * (sum(l,Td(l)) + sum(j,Tz(j)) + sum(j,Tm(j)) - sum(j,AgE(j)) - sum(l,AgH(l)));
 250  eqXg(i)..     Xg(i)   =e= mu(i) * (sum(l,Td(l)) + sum(j,Tz(j)) + sum(j,Tm(j)) - Sg - sum(j,AgE(j)) - sum(l,AgH(l)))/pq(i);
 251  eqctzsse(i).. CssE(i) =e= ctzsse(i) * F['L',i];
 252  eqctzssh(l).. CssH(l) =e= ctzssh(l) * (FF[l,'L']);
 253  * inversión
 254  eqXv(i)..     Xv(i)   =e= lambda(i) * (sum(l,Sp(l)) + Sg + epsilon*Sf) / pq(i);
 255  eqXp(l,i)..   Xp(l,i) =e= alpha(l,i) * (sum(h,pf(h) * FF(l,h)) + AgH(l) + PssH0(l) - (Sp(l) + Td(l)+CssH(l))) / pq(i) + DeAd(l,i);
 256  * producto de Armington
 257  eqpqs(i)..   Q(i)     =e=  gamma(i) * (deltam(i) * M(i) ** eta(i) + deltad(i) * D(i) ** eta(i)) ** (1 / eta(i));
 258  eqM(i)..     M(i)     =e= (gamma(i) ** eta(i) * deltam(i) * pq(i) / ((1 + taum(i)) * pm(i))) ** (1 / (1 - eta(i))) * Q(i);
 259  eqD(i)..     D(i)     =e= (gamma(i) ** eta(i) * deltad(i) * pq(i) / pd(i)) ** (1 / (1 - eta(i))) * Q(i);
 260  * función de transformacion CET
 261  eqpzd(i)..   Z(i)     =e=  theta(i) * (xie(i) * E(i) ** phi(i) + xid(i) * D(i) ** phi(i)) ** (1 / phi(i));
 262  eqE(i)..     E(i)     =e= (theta(i) ** phi(i) * xie(i) * (1 + tauz(i) + CssE(i) / Z(i) - AgE(i) / Z(i) + Apz) * pz(i) / pe(i) )** (1 / (1 - phi(i))) * Z(i);
 263  eqDs(i)..    D(i)     =e= (theta(i) ** phi(i) * xid(i) * (1 + tauz(i) + CssE(i) / Z(i) - AgE(i) / Z(i) + Apz) * pz(i) / pd(i)) ** (1 / (1 - phi(i))) * Z(i);
 264  eqFF(l,h)..  FF(l,h)  =e= sum(i,F(h,i)) * FF0(l,h) / sum(n,FF0(n,h));
 265  * condición de equilibrio del mercado
 266  eqpqd(i)..   Q(i)     =e= sum(l, Xp(l,i)) + Xg(i) + Xv(i) + sum(j, X(i,j));
 267  eqpf(h)..    sum(i,F(h,i)) =e= sum(l,FF(l,h));
 268   
 269  * función objetivo ficticia
 270  obj..       UU        =e= sum(l, prod(i, Xp(l,i) ** alpha(l,i))) - 100000. * Apz * Apz;
 271   
 272  * inicialización de variables
 273  Y.l(j)    = Y0(j);
 274  F.l(h,j)  = F0(h,j);
 275  X.l(i,j)  = X0(i,j);
 276  Z.l(j)    = Z0(j);
 277  Xp.l(l,i) = Xp0(l,i);
 278  Xg.l(i)   = Xg0(i);
 279  Xv.l(i)   = Xv0(i);
 280  E.l(i)    = E0(i);
 281  M.l(i)    = M0(i);
 282  Q.l(i)    = Q0(i);
 283  D.l(i)    = D0(i);
 284  pf.l(h)   = 1;
 285  py.l(j)   = 1;
 286  pz.l(j)   = 1;
 287  pq.l(i)   = 1;
 288  pe.l(i)   = 1;
 289  pm.l(i)   = 1;
 290  pd.l(i)   = 1;
 291  epsilon.l = 1;
 292  Sp.l(l)   = Sp0(l);
 293  Sg.l      = Sg0;
 294  Td.l(l)   = Td0(l);
 295  Tz.l(j)   = Tz0(j);
 296  Tm.l(i)   = Tm0(i);
 297  CssH.l(l) = CssH0(l);
 298  CssE.l(i) = CssE0(i);
 299  AgE.l(i)  = AgE0(i);
 300  AgH.l(l)  = AgH0(l);
 301  Apz.l     = 0;
 302   
 303  * cota inferior de las variables, puede eliminar o producir infactibilidad, según el caso
 304  Y.lo(j)     = 0.0000;
 305  F.lo(h,j)   = 0.0000;
 306  X.lo(i,j)   = 0.0000;
 307  Z.lo(j)     = 0.0000;
 308  Xp.lo(l,i)  = 0.0000;
 309  Xg.lo(i)    = 0.0000;
 310  Xv.lo(i)    = 0.0000;
 311  E.lo(i)     = 0.0000;
 312  M.lo(i)     = 0.0000;
 313  Q.lo(i)     = 0.0000;
 314  D.lo(i)     = 0.0000;
 315  pf.lo(h)    = 0.0000;
 316  py.lo(j)    = 0.0000;
 317  pz.lo(j)    = 0.0000;
 318  pq.lo(i)    = 0.0000;
 319  pe.lo(i)    = 0.0000;
 320  pm.lo(i)    = 0.0000;
 321  pd.lo(i)    = 0.0000;
 322  epsilon.lo  = 0.0000;
 323  Sp.lo(l)    = 0.0000;
 324  Sg.lo       = 0.0000;
 325  Td.lo(l)    = 0.0000;
 326  Tz.lo(j)    = 0.0000;
 327  Tm.lo(i)    = 0.0000;
 328  CssH.lo(l)  = 0.0000;
 329  CssE.lo(i)  = 0.0000;
 330  AgE.lo(i)   = 0.0000;
 331  AgH.lo(l)   = 0.0000;
 332   
 333  * precio de referencia
 334   
 335  pf.fx('L') = 1.;
 336  pf.fx('K') = 1.;
 337  epsilon.fx = 1.;
 338   
 339  Model mca / all /;
 340   
 341   
 342  option nlp=CONOPT;
 343  solve mca maximizing UU using nlp;
 344   
 345  * salvar a un fichero para después exportar (manualmente) a excel
 346   
 347  execute_unload 'vab_base_excel.gdx'
 348     Y.l,F.l,FF.l,X.l,Z.l,Xp.l,Xg.l,Xv.l,E.l,M.l,Q.l,D.l,pf.l,py.l,pz.l,pq.l,pe.l,pm.l,pd.l,epsilon,
 349     Sp.l,Sg.l,Td.l,Tz.l,Tm.l,CssH.l,CssE.l,PssH0,AgE.l,AgH.l,Apz.l,Sf,
 350     alpha,beta,b,ax,ay,mu,lambda,deltam,deltad,gamma,xid,xie,theta,ssp,ssg,taud,tauz,taum,ctzsse,ctzssh,cage,cagh
 351  ;
 352   
 353  * bienestar económico
 354  Parameter
 355     UU0(l) 'nivel de utilidad en el equilibrio de base'
 356     ep0(l) 'gasto en el equilibrio de base'
 357     ep1(l) 'gasto en el equilibrio del nuevo escenario'
 358     EV(l)  'variación equivalente de Hicksian'
 359  ;
 360   
 361  UU0(l) = prod(i, Xp0(l,i)**alpha(l,i));
 362  ep0(l) = UU0(l) /prod(i, (alpha(l,i)/1)**alpha(l,i));
 363  ep1(l) = (prod(i,Xp.l(l,i)**alpha(l,i))) / prod(i, (alpha(l,i)/1)**alpha(l,i));
 364  EV(l)  = ep1(l) - ep0(l);
 365   
 366  display EV;
 367   
