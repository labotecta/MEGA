  36   
  37  * cargando los valores iniciales
  38  Parameter
  39     Y0(j)     'factor compuesto de las empresas j'
  40     F0(h,j)   'los factores h empleados por las empresas j'
  41     X0(i,j)   'inputs intermedios'
  42     Z0(j)     'producción de las empresas j'
  43     Xp0(l,i)  'consumo de los hogares l de los productos i'
  44     Xg0(i)    'consumo del gobierno del producto i'
  45     Xv0(i)    'demanda de inversión de la empresa i'
  46     E0(i)     'exportaciones de las empresas i'
  47     M0(i)     'importaciones de las empresas i'
  48     Q0(i)     "producto compuesto de Armington de las empresas i"
  49     D0(i)     'consumo domestico de los productos i'
  50     Sp0(l)    'ahorro de los hogares l'
  51     Sg0       'ahorro del gobierno'
  52     Td0(l)    'impuestos a los hogares l'
  53     Tz0(j)    'impuestos a las producciones j'
  54     Tm0(j)    'aranceles a los productos j'
  55     FF(l,h)   'factores h prestados por los hogares l'
  56     Sf        'ahorro exterior en moneda local'
  57     CssH0(l)  'pagos a la seguridad social de los hogares l'
  58     CssE0(i)  'pagos a la seguridad social de las empresas i'
  59     PssH0(l)  'pensiones de los hogares l'
  60     AgE0(i)   'ayudas del gobierno a las empresas i'
  61     AgH0(l)   'ayudas del gobierno a los hogares l'
  62     pWe(i)    'precio de exportación en moneda local'
  63     pWm(i)    'precio de importación en moneda local'
  64     tauz(i)   'tasa de impuestos a las producciones j'
  65     taum(i)   'tasa de aranceles a los productos j'
  66     ctzsse(i) 'tasa de la seg.social a las empresas i'
  67     ctzssh(l) 'tasa de la seg.social a los hogares l'
  68  ;
  69   
  70  Td0(l)   = SAM("SP",l)+SAM("INP",l);
  71  Tz0(j)   = SAM("INP",j);
  72  Tm0(j)   = 0.000001;
  73  F0(h,j)  = SAM(h,j);
  74  Y0(j)    = sum(h, F0(h,j));
  75  X0(i,j)  = SAM(i,j);
  76  Z0(j)    = Y0(j) +sum(i, X0(i,j));
  77  M0(i)    = SAM("SE",i);
  78  CssE0(i) = SAM("CSS",i);
  79  CssH0(l) = SAM("CSS",l);
  80  PssH0(l) = SAM(l,"CSS");
  81  AgE0(i)  = SAM(i,'AYD');
  82  AgH0(l)  = SAM(l,'AYD');
  83  tauz(j)$(Z0(j) eq 0)  = 0.;
  84  tauz(j)$(Z0(j) ne 0)  = Tz0(j)/Z0(j);
  85  taum(j)$(M0(j) eq 0)  = 0.;
  86  taum(j)$(M0(j) ne 0)  = Tm0(j)/M0(j);
  87  Xp0(l,i) = SAM(i,l);
  88  FF(l,h)  = SAM(l,h);
  89  Xg0(i)   = SAM(i,"SP");
  90  Xv0(i)   = SAM(i,"A-I");
  91  E0(i)    = SAM(i,"SE");
  92  Q0(i)    = sum(l, Xp0(l,i))+Xg0(i)+Xv0(i)+sum(j, X0(i,j));
  93  D0(i)    = (1+tauz(i))*Z0(i)-E0(i)+CssE0(i)-AgE0(i);
  94  Sp0(l)   = SAM("A-I",l);
  95  Sg0      = SAM("A-I","SP");
  96  Sf       = SAM("A-I","SE");
  97  ctzsse(i) = CssE0(i)/F0('L',i);
  98  ctzssh(l)$(FF(l,'L')+PssH0(l) eq 0) = 0.;
  99  ctzssh(l)$(FF(l,'L')+PssH0(l) ne 0) = CssH0(l)/(FF(l,'L')+PssH0(l));
 100  pWe(i)   = 1;
 101  pWm(i)   = 1;
 102   
 103  display FF,F0,Y0,X0,Xp0,Xg0,Xv0,Q0,Z0,E0,M0,D0,Tz0,Tm0,Sp0,Td0,AgE0,AgH0,Sg0,Sf,
 104          CssE0,CssH0,PssH0;
 105   
 106  * calibrado
 107  Parameter
 108     sigma(i) 'elasticidad de sustitución (importación) de los sectores i'
 109     psi(i)   'elasticidad de transformación entre local y exportación (CET) de los sectores i'
 110     eta(i)   'parámetro de elasticidad de sustitución  de los sectores i'
 111     phi(i)   'parámetro de elasticidad de transformación de los sectores i';
 112   
 113  sigma(i) =  2;
 114  psi(i)   =  2;
 115  eta(i)   = (sigma(i) - 1)/sigma(i);
 116  phi(i)   = (psi(i) + 1)/psi(i);
 117   
 118  Parameter
 119     alpha(l,i) 'participación de los productos i en la función de utilidad de los hogares l'
 120     beta(h,j)  'participación de los factores h en la función de producción de las empresas j'
 121     b(j)       'parámetro de eswcala de la función de producción de las empresas j'
 122     ax(i,j)    'coeficietes de los imputs intermedios'
 123     ay(j)      'coeficiente del input de factor compuesto para las empresas j'
 124     mu(i)      'participación del producto i en el consumo del gobierno'
 125     lambda(i)  'participación en la demanda de inversión de las empresas i'
 126     deltam(i)  'participación de la importación de productos i en la función de Armington'
 127     deltad(i)  'participación de la producción local de productos i en la función de Armington'
 128     gamma(i)   'parámetro de escala de la función de producción de Armington de las empresas i'
 129     xid(i)     'coeficiente de participación en la CET de la demanda local de los sectores i'
 130     xie(i)     'coeficiente de participación en la CET de la exportación de los sectores i'
 131     theta(i)   'coeficiente de escala de la CET de exportación de los sectores i'
 132     ssp(l)     'apropensión al ahorro de los hogares l'
 133     ssg        'propensión al ahorro del gobierno'
 134     taud(l)    'tasa de impuestos directos a los hogares l'
 135     cage(i)    'coeficiente de las ayudas del gobierno a las empresas i'
 136     cagh(l)    'coeficiente de las ayudas del gobierno a los hogares l'
 137     alpha_c(l,i)'copia de alpha'
 138   
 139     beta_c(h,j) 'copia'
 140  ;
 141   
 142  alpha(l,i)  =  Xp0(l,i)/sum(j, Xp0(l,j));
 143  beta(h,j)   =  F0(h,j)/sum(k, F0(k,j));
 144  b(j)        =  Y0(j)/prod(h, F0(h,j)**beta(h,j));
 145  ax(i,j)     =  X0(i,j)/Z0(j);
 146  ay(j)       =  Y0(j)/Z0(j);
 147  mu(i)       =  Xg0(i)/sum(j, Xg0(j));
 148  lambda(i)   =  Xv0(i)/(sum(l,Sp0(l))+Sg0+Sf);
 149  deltam(i)   = (1+taum(i))*M0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 150  deltad(i)   =  D0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 151  gamma(i)    =  Q0(i)/(deltam(i)*M0(i)**eta(i)+deltad(i)*D0(i)**eta(i))**(1/eta(i));
 152  xie(i)      =  E0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 153  xid(i)      =  D0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 154  theta(i)    =  Z0(i)/(xie(i)*E0(i)**phi(i)+xid(i)*D0(i)**phi(i))**(1/phi(i));
 155  ssp(l)$((sum(h, FF(l,h))+ PssH0(l)) eq 0) = 0.;
 156  ssp(l)$((sum(h, FF(l,h))+ PssH0(l)) ne 0) = Sp0(l)/(sum(h, FF(l,h))+ PssH0(l));
 157  ssg         =  Sg0/(sum(l,Td0(l))+sum(j,Tz0(j))+sum(j,Tm0(j))-sum(j,AgE0(j))-sum(l,AgH0(l)));
 158  taud(l)$((sum(h, FF(l,h))+ PssH0(l)) eq 0) = 0.;
 159  taud(l)$((sum(h, FF(l,h))+ PssH0(l)) ne 0) = Td0(l)/(sum(h, FF(l,h))+ PssH0(l));
 160  cage(i)     = AgE0(i) / (sum(n,Td0(n)) + sum(j,Tz0(j)) + sum(j,Tm0(j)));
 161  cagh(l)     = AgH0(l) / (sum(n,Td0(n)) + sum(j,Tz0(j)) + sum(j,Tm0(j)));
 162   
 163  alpha_c(l,i)=alpha(l,i);
 164  beta_c(h,j) =beta(h,j)
 165   
 166  display phi,tauz,taum,alpha,beta,b,ax,ay,mu,lambda,deltam,deltad,gamma,xie,xid,
 167          theta,ssp,ssg,taud,ctzsse,ctzssh,cage,cagh;
 168   
 169  Variable
 170     Y(j)     'factor compuesto de los sectores i'
 171     F(h,i)   'uso de los factores h por los sectores i'
 172     X(i,j)   'consumo intermedio de los productos i por los sectores j'
 173     Z(i)     'producción bruta de los sectores i'
 174     Xp(l,i)  'demanda de los hogares l del producto i'
 175     Xg(i)    'demanda del gobierno de los productos i'
 176     Xv(i)    'demanda de inversión de los sectores i'
 177     E(i)     'exportaciones de los productos i'
 178     M(i)     'importaciones de los productos i'
 179     Q(i)     "producción del producto compuesto de Armington por los sectores i"
 180     D(i)     'demanda local de los productos i'
 181     pf(h)    'precio de los factores h'
 182     py(i)    'precio de los factores compuestos i'
 183     pz(i)    'precio de producir los productos locales i'
 184     pq(i)    "precio de los productos compuesto de Armington i"
 185     pe(i)    'precio de exportación de los productos i en moneda local'
 186     pm(i)    'precio de importación de los productos i en moneda local'
 187     pd(i)    'precio de los productos i para los compradores locales'
 188     epsilon  'cotización: moneda local/ moneda extranjera'
 189     Sp(l)    'ahorro de los hogares l'
 190     Sg       'ahorro del gobierno'
 191     Td(l)    'impuestos directos a los hogares l'
 192     Tz(i)    'impuesto a la producción de los sectores i'
 193     Tm(i)    'arancel de importación para los productos i'
 194     CssH(l)  'pagos a la seguridad social de los hogares l'
 195     CssE(i)  'pagos a la seguridad social de las empresas i'
 196     AgE(i)   'ayudas del gobierno a las empresas i'
 197     AgH(l)   'ayudas del gobierno a los hogares l'
 198     A        'variable ficticia'
 199     UU       'utilidad [ficticia]'
 200  ;
 201   
 202  Equation
 203     eqpy(i)     'producción del factor compuesto de los sectores i'
 204     eqF(h,j)    'uso de los factores h por los sectores i'
 205     eqX(i,j)    'consumo intermedio de los productos i por los sectores j'
 206     eqY(i)      'demanda del factor compuesto de los sectores i'
 207     eqpzs(i)    'coste unitario de producción de los sectores i'
 208     eqTd(l)     'impuestos directos a los hogares l'
 209     eqTz(i)     'impuesto a la producción de los sectores i'
 210     eqTm(i)     'arancel de importación para los productos i'
 211     eqAgE(i)    'ayudas del gobierno a las empresas i'
 212     eqAgH(l)    'ayudas del gobierno a los hogares l'
 213     eqSp(l)     'ahorro de los hogares l'
 214     eqSg        'ahorro del gobierno'
 215     eqctzsse(i) 'cotización seg social de las empresas i'
 216     eqctzssh(l) 'cotización seg social de los hogares l'
 217     eqXg(i)     'demanda del gobierno de los productos i'
 218     eqXv(i)     'demanda de inversión de los sectores i'
 219     eqXp(l,i)   'demanda de los hogares l del producto i'
 220     eqpe(i)     'precio de exportación de los productos i en moneda extranjera'
 221     eqpm(i)     'precio de importación de los productos i en moneda extranjera'
 222     eqepsilon   'balanza de pagos'
 223     eqpqs(i)    'función de Armington para los productos i'
 224     eqM(i)      'importaciones de los productos i'
 225     eqD(i)      'domestic good demand function'
 226     eqpzd(i)    'transformation function'
 227     eqDs(i)     'demanda local de los productos i'
 228     eqE(i)      'exportaciones de los productos i'
 229     eqpqd(i)    'condición de equilibrio del mercado para el producto compuesto de los sectores i'
 230     eqpf(h)     'condición de equilibrio del mercado para los factores h'
 231     obj         'utilidad [ficticia]'
 232  ;
 233   
 234  * comercio internacional
 235  eqpe(i)..   pe(i)     =e= epsilon*pWe(i);
 236   
 237  eqpm(i)..   pm(i)     =e= epsilon*pWm(i);
 238   
 239  eqepsilon.. sum(i, pWe(i)*E(i)) + Sf =e= sum(i, pWm(i)*M(i));
 240   
 241  * producción local
 242  eqpy(j)..     Y(j)    =e= b(j)*prod(h, F(h,j)**beta(h,j));
 243   
 244  eqF(h,j)..    F(h,j)  =e= beta(h,j)*py(j)*Y(j)/pf(h);
 245   
 246  eqX(i,j)..    X(i,j)  =e= ax(i,j)*Z(j);
 247   
 248  eqY(j)..      Y(j)    =e= ay(j)*Z(j);
 249   
 250  * no se puede usar valor abosluto de A porque da lugar a ecuaciones con derivada discontinua
 251  eqpzs(j)..    pz(j)   =e= ay(j)*py(j)+sum(i, ax(i,j)*pq(i))+A;
 252   
 253  * gobierno
 254  eqTd(l)..     Td(l)   =e= taud(l) * (sum(h, pf(h)*FF(l,h))+PssH0(l));
 255   
 256  eqTz(j)..     Tz(j)   =e= tauz(j)*pz(j)*Z(j);
 257   
 258  eqTm(i)..     Tm(i)   =e= taum(i)*pm(i)*M(i);
 259   
 260  eqAgE(i)..    AgE(i)  =e= cage(i) * (sum(n,Td(n))+sum(j,Tz(j))+sum(j,Tm(j)));
 261   
 262  eqAgH(l)..    AgH(l)  =e= cagh(l) * (sum(n,Td(n))+sum(j,Tz(j))+sum(j,Tm(j)));
 263   
 264  * ahorro
 265  eqSp(l)..     Sp(l)   =e= ssp(l) * (sum(h, pf(h)*FF(l,h))+PssH0(l));
 266   
 267  eqSg..        Sg      =e= ssg*(sum(l,Td(l))+sum(j,Tz(j))+sum(j,Tm(j))-sum(j,AgE(j))-sum(l,AgH(l)));
 268   
 269  eqXg(i)..     Xg(i)   =e= mu(i)   * (sum(l,Td(l))+sum(j,Tz(j))+sum(j,Tm(j))-Sg-sum(j,AgE(j))-sum(l,AgH(l)))/pq(i);
 270   
 271  eqctzsse(i).. CssE(i) =e= ctzsse(i) * F['L',i];
 272   
 273  eqctzssh(l).. CssH(l) =e= ctzssh(l) * (FF[l,'L'] + PssH0(l));
 274   
 275  * inversión
 276  eqXv(i)..     Xv(i)   =e= lambda(i)*(sum(l,Sp(l)) + Sg + epsilon*Sf)/pq(i);
 277   
 278  * consumo de los hogares
 279  eqXp(l,i)..   Xp(l,i) =e= alpha(l,i) * (sum(h,pf(h)*FF(l,h))+AgH(l)+PssH0(l)-(Sp(l)+Td(l)+CssH(l)))/pq(i);
 280   
 281  * producto de Armington
 282  eqpqs(i)..  Q(i)      =e=  gamma(i)*(deltam(i)*M(i)**eta(i) + deltad(i)*D(i)**eta(i))**(1/eta(i));
 283   
 284  eqM(i)..    M(i)      =e= (gamma(i)**eta(i)*deltam(i)*pq(i)/((1+taum(i))*pm(i)))**(1/(1-eta(i)))*Q(i);
 285   
 286  eqD(i)..    D(i)      =e= (gamma(i)**eta(i)*deltad(i)*pq(i)/pd(i))**(1/(1-eta(i)))*Q(i);
 287   
 288  * función de transformacion CET
 289  eqpzd(i)..  Z(i)      =e=  theta(i)*(xie(i)*E(i)**phi(i)+xid(i)*D(i)**phi(i))**(1/phi(i));
 290   
 291  eqE(i)..    E(i)      =e= (theta(i)**phi(i)*xie(i)*(1+tauz(i)+CssE(i)/Z(i)-AgE(i)/Z(i))*pz(i)/pe(i))**(1/(1-phi(i)))*Z(i);
 292   
 293  eqDs(i)..   D(i)      =e= (theta(i)**phi(i)*xid(i)*(1+tauz(i)+CssE(i)/Z(i)-AgE(i)/Z(i))*pz(i)/pd(i))**(1/(1-phi(i)))*Z(i);
 294   
 295  * condición de equilibrio del mercado
 296  eqpqd(i)..  Q(i)      =e= sum(l, Xp(l,i)) + Xg(i) + Xv(i) + sum(j, X(i,j));
 297   
 298  eqpf(h)..   sum(j, F(h,j)) =e= sum(l,FF(l,h));
 299   
 300  * función objetivo ficticia
 301  obj..       UU        =e= sum(l, prod(i, Xp(l,i)**alpha(l,i)))-1000000000*A*A;
 302   
 303  * inicialización de variables
 304  Y.l(j)    = Y0(j);
 305  F.l(h,j)  = F0(h,j);
 306  X.l(i,j)  = X0(i,j);
 307  Z.l(j)    = Z0(j);
 308  Xp.l(l,i) = Xp0(l,i);
 309  Xg.l(i)   = Xg0(i);
 310  Xv.l(i)   = Xv0(i);
 311  E.l(i)    = E0(i);
 312  M.l(i)    = M0(i);
 313  Q.l(i)    = Q0(i);
 314  D.l(i)    = D0(i);
 315  pf.l(h)   = 1;
 316  py.l(j)   = 1;
 317  pz.l(j)   = 1;
 318  pq.l(i)   = 1;
 319  pe.l(i)   = 1;
 320  pm.l(i)   = 1;
 321  pd.l(i)   = 1;
 322  epsilon.l = 1;
 323  Sp.l(l)   = Sp0(l);
 324  Sg.l      = Sg0;
 325  Td.l(l)   = Td0(l);
 326  Tz.l(j)   = Tz0(j);
 327  Tm.l(i)   = Tm0(i);
 328  CssH.l(l) = CssH0(l);
 329  CssE.l(i) = CssE0(i);
 330  AgE.l(i)  = AgE0(i);
 331  AgH.l(l)  = AgH0(l);
 332   
 333  * cota inferior de las variables, puede eliminar o producir infactibilidad, según el caso
 334  Y.lo(j)     = 0.0000;
 335  F.lo(h,j)   = 0.0000;
 336  X.lo(i,j)   = 0.0000;
 337  Z.lo(j)     = 0.0000;
 338  Xp.lo(l,i)  = 0.0000;
 339  Xg.lo(i)    = 0.0000;
 340  Xv.lo(i)    = 0.0000;
 341  E.lo(i)     = 0.0000;
 342  M.lo(i)     = 0.0000;
 343  Q.lo(i)     = 0.0000;
 344  D.lo(i)     = 0.0000;
 345  pf.lo(h)    = 0.0000;
