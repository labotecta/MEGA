A Standard CGE Model in Ch. 6 (STDCGE,SEQ=276)
C o m p i l a t i o n


   2   
      No description.
       
       
      Hosoe, N, Gasawa, K, and Hashimoto, H
      Handbook of Computible General Equilibrium Modeling
      University of Tokyo Press, Tokyo, Japan, 2004
       
      Keywords: nonlinear programming, general equilibrium model, social accounting
                matrix, utility maximization problem
  14   
  15  Set
  16     u    'SAM entry' / BRD, MLK, CAP, LAB, IDT, TRF, HOH, GOV, INV, EXT /
  17     i(u) 'goods'     / BRD, MLK                                         /
  18     h(u) 'factor'    /           CAP, LAB                               /;
  19   
  20  Alias (u,v), (i,j), (h,k);
  21   
  22  Table SAM(u,v) 'social accounting matrix'
  23           BRD   MLK   CAP   LAB   IDT   TRF   HOH   GOV   INV   EXT
  24     BRD    21     8                            20    19    16     8
  25     MLK    17     9                            30    14    15     4
  26     CAP    20    30
  27     LAB    15    25
  28     IDT     5     4
  29     TRF     1     2
  30     HOH                50    40
  31     GOV                             9     3    23
  32     INV                                        17     2          12
  33     EXT    13    11                                                ;
  34   
  35  * Loading the initial values
  36  Parameter
  37     Y0(j)   'composite factor'
  38     F0(h,j) 'the h-th factor input by the j-th firm'
  39     X0(i,j) 'intermediate input'
  40     Z0(j)   'output of the j-th good'
  41     Xp0(i)  'household consumption of the i-th good '
  42     Xg0(i)  'government consumption'
  43     Xv0(i)  'investment demand'
  44     E0(i)   'exports'
  45     M0(i)   'imports'
  46     Q0(i)   "Armington's composite good"
  47     D0(i)   'domestic good'
  48     Sp0     'private saving'
  49     Sg0     'government saving'
  50     Td0     'direct tax'
  51     Tz0(j)  'production tax'
  52     Tm0(j)  'import tariff'
  53     FF(h)   'factor endowment of the h-th factor'
  54     Sf      'foreign saving in US dollars'
  55     pWe(i)  'export price in US dollars'
  56     pWm(i)  'import price in US dollars'
  57     tauz(i) 'production tax rate'
  58     taum(i) 'import tariff rate';
  59   
  60  Td0     = SAM("GOV","HOH");
  61  Tz0(j)  = SAM("IDT",j);
  62  Tm0(j)  = SAM("TRF",J);
  63  F0(h,j) = SAM(h,j);
  64  Y0(j)   = sum(h, F0(h,j));
  65  X0(i,j) = SAM(i,j);
  66  Z0(j)   = Y0(j) +sum(i, X0(i,j));
  67  M0(i)   = SAM("EXT",i);
  68  tauz(j) = Tz0(j)/Z0(j);
  69  taum(j) = Tm0(j)/M0(j);
  70  Xp0(i)  = SAM(i,"HOH");
  71  FF(h)   = SAM("HOH",h);
  72  Xg0(i)  = SAM(i,"GOV");
  73  Xv0(i)  = SAM(i,"INV");
  74  E0(i)   = SAM(i,"EXT");
  75  Q0(i)   = Xp0(i)+Xg0(i)+Xv0(i)+sum(j, X0(i,j));
  76  D0(i)   = (1+tauz(i))*Z0(i)-E0(i);
  77  Sp0     = SAM("INV","HOH");
  78  Sg0     = SAM("INV","GOV");
  79  Sf      = SAM("INV","EXT");
  80  pWe(i)  = 1;
  81  pWm(i)  = 1;
  82   
  83  display Y0, F0, X0, Z0, Xp0, Xg0, Xv0, E0, M0, Q0, D0, Sp0, Sg0, Td0, Tz0, Tm0
  84          FF, Sf, tauz, taum;
  85   
  86  * Calibration
  87  Parameter
  88     sigma(i) 'elasticity of substitution'
  89     psi(i)   'elasticity of transformation'
  90     eta(i)   'substitution elasticity parameter'
  91     phi(i)   'transformation elasticity parameter';
  92   
  93  sigma(i) =  2;
  94  psi(i)   =  2;
  95  eta(i)   = (sigma(i) - 1)/sigma(i);
  96  phi(i)   = (psi(i) + 1)/psi(i);
  97   
  98  Parameter
  99     alpha(i)  'share parameter in utility func.'
 100     beta(h,j) 'share parameter in production func.'
 101     b(j)      'scale parameter in production func.'
 102     ax(i,j)   'intermediate input requirement coeff.'
 103     ay(j)     'composite fact. input req. coeff.'
 104     mu(i)     'government consumption share'
 105     lambda(i) 'investment demand share'
 106     deltam(i) 'share par. in Armington func.'
 107     deltad(i) 'share par. in Armington func.'
 108     gamma(i)  'scale par. in Armington func.'
 109     xid(i)    'share par. in transformation func.'
 110     xie(i)    'share par. in transformation func.'
 111     theta(i)  'scale par. in transformation func.'
 112     ssp       'average propensity for private saving'
 113     ssg       'average propensity for gov. saving'
 114     taud      'direct tax rate';
 115   
 116  alpha(i)  =  Xp0(i)/sum(j, Xp0(j));
 117  beta(h,j) =  F0(h,j)/sum(k, F0(k,j));
 118  b(j)      =  Y0(j)/prod(h, F0(h,j)**beta(h,j));
 119  ax(i,j)   =  X0(i,j)/Z0(j);
 120  ay(j)     =  Y0(j)/Z0(j);
 121  mu(i)     =  Xg0(i)/sum(j, Xg0(j));
 122  lambda(i) =  Xv0(i)/(Sp0+Sg0+Sf);
 123  deltam(i) = (1+taum(i))*M0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 124  deltad(i) =  D0(i)**(1-eta(i))/((1+taum(i))*M0(i)**(1-eta(i)) + D0(i)**(1-eta(i)));
 125  gamma(i)  =  Q0(i)/(deltam(i)*M0(i)**eta(i)+deltad(i)*D0(i)**eta(i))**(1/eta(i));
 126  xie(i)    =  E0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 127  xid(i)    =  D0(i)**(1-phi(i))/(E0(i)**(1-phi(i))+D0(i)**(1-phi(i)));
 128  theta(i)  =  Z0(i)/(xie(i)*E0(i)**phi(i)+xid(i)*D0(i)**phi(i))**(1/phi(i));
 129  ssp       =  Sp0/sum(h, FF(h));
 130  ssg       =  Sg0/(Td0+sum(j, Tz0(j))+sum(j, Tm0(j)));
 131  taud      =  Td0/sum(h, FF(h));
 132   
 133  display alpha, beta,  b,   ax,  ay, mu, lambda, deltam, deltad, gamma, xie
 134          xid,   theta, ssp, ssg, taud;
 135   
 136  Variable
 137     Y(j)    'composite factor'
 138     F(h,j)  'the h-th factor input by the j-th firm'
 139     X(i,j)  'intermediate input'
 140     Z(j)    'output of the j-th good'
 141     Xp(i)   'household consumption of the i-th good'
 142     Xg(i)   'government consumption'
 143     Xv(i)   'investment demand'
 144     E(i)    'exports'
 145     M(i)    'imports'
 146     Q(i)    "Armington's composite good"
 147     D(i)    'domestic good'
 148     pf(h)   'the h-th factor price'
 149     py(j)   'composite factor price'
 150     pz(j)   'supply price of the i-th good'
 151     pq(i)   "Armington's composite good price"
 152     pe(i)   'export price in local currency'
 153     pm(i)   'import price in local currency'
 154     pd(i)   'the i-th domestic good price'
 155     epsilon 'exchange rate'
 156     Sp      'private saving'
 157     Sg      'government saving'
 158     Td      'direct tax'
 159     Tz(j)   'production tax'
 160     Tm(i)   'import tariff'
 161     UU      'utility [fictitious]';
 162   
 163  Equation
 164     eqpy(j)   'composite factor agg. func.'
 165     eqF(h,j)  'factor demand function'
 166     eqX(i,j)  'intermediate demand function'
 167     eqY(j)    'composite factor demand function'
 168     eqpzs(j)  'unit cost function'
 169     eqTd      'direct tax revenue function'
 170     eqTz(j)   'production tax revenue function'
 171     eqTm(i)   'import tariff revenue function'
 172     eqXg(i)   'government demand function'
 173     eqXv(i)   'investment demand function'
 174     eqSp      'private saving function'
 175     eqSg      'government saving function'
 176     eqXp(i)   'household demand function'
 177     eqpe(i)   'world export price equation'
 178     eqpm(i)   'world import price equation'
 179     eqepsilon 'balance of payments'
 180     eqpqs(i)  'Armington function'
 181     eqM(i)    'import demand function'
 182     eqD(i)    'domestic good demand function'
 183     eqpzd(i)  'transformation function'
 184     eqDs(i)   'domestic good supply function'
 185     eqE(i)    'export supply function'
 186     eqpqd(i)  'market clearing cond. for comp. good'
 187     eqpf(h)   'factor market clearing condition'
 188     obj       'utility function [fictitious]';
 189   
 190  * domestic production
 191  eqpy(j)..   Y(j)   =e= b(j)*prod(h, F(h,j)**beta(h,j));
 192   
 193  eqF(h,j)..  F(h,j) =e= beta(h,j)*py(j)*Y(j)/pf(h);
 194   
 195  eqX(i,j)..  X(i,j) =e= ax(i,j)*Z(j);
 196   
 197  eqY(j)..    Y(j)   =e= ay(j)*Z(j);
 198   
 199  eqpzs(j)..  pz(j)  =e= ay(j)*py(j) + sum(i, ax(i,j)*pq(i));
 200   
 201  * government behavior
 202  eqTd..      Td     =e= taud*sum(h, pf(h)*FF(h));
 203   
 204  eqTz(j)..   Tz(j)  =e= tauz(j)*pz(j)*Z(j);
 205   
 206  eqTm(i)..   Tm(i)  =e= taum(i)*pm(i)*M(i);
 207   
 208  eqXg(i)..   Xg(i)  =e= mu(i)*(Td + sum(j, Tz(j)) + sum(j, Tm(j)) - Sg)/pq(i);
 209   
 210  * investment behavior
 211  eqXv(i)..   Xv(i)  =e= lambda(i)*(Sp + Sg + epsilon*Sf)/pq(i);
 212   
 213  * savings
 214  eqSp..      Sp     =e= ssp*sum(h, pf(h)*FF(h));
 215   
 216  eqSg..      Sg     =e= ssg*(Td + sum(j, Tz(j)) + sum(j, Tm(j)));
 217   
 218  * household consumption
 219  eqXp(i)..   Xp(i)  =e= alpha(i)*(sum(h, pf(h)*FF(h)) - Sp - Td)/pq(i);
 220   
 221  * international trade
 222  eqpe(i)..   pe(i)  =e= epsilon*pWe(i);
 223   
 224  eqpm(i)..   pm(i)  =e= epsilon*pWm(i);
 225   
 226  eqepsilon.. sum(i, pWe(i)*E(i)) + Sf =e= sum(i, pWm(i)*M(i));
 227   
 228  * Armington function
 229  eqpqs(i)..  Q(i)   =e=  gamma(i)*(deltam(i)*M(i)**eta(i) + deltad(i)*D(i)**eta(i))**(1/eta(i));
 230   
 231  eqM(i)..    M(i)   =e= (gamma(i)**eta(i)*deltam(i)*pq(i)/((1+taum(i))*pm(i)))**(1/(1-eta(i)))*Q(i);
 232   
 233  eqD(i)..    D(i)   =e= (gamma(i)**eta(i)*deltad(i)*pq(i)/pd(i))**(1/(1-eta(i)))*Q(i);
 234   
 235  * transformation function
 236  eqpzd(i)..  Z(i)   =e=  theta(i)*(xie(i)*E(i)**phi(i)+xid(i)*D(i)**phi(i))**(1/phi(i));
 237   
 238  eqE(i)..    E(i)   =e= (theta(i)**phi(i)*xie(i)*(1+tauz(i))*pz(i)/pe(i))**(1/(1-phi(i)))*Z(i);
 239   
 240  eqDs(i)..   D(i)   =e= (theta(i)**phi(i)*xid(i)*(1+tauz(i))*pz(i)/pd(i))**(1/(1-phi(i)))*Z(i);
 241   
 242  * market clearing condition
 243  eqpqd(i)..  Q(i)   =e= Xp(i) + Xg(i) + Xv(i) + sum(j, X(i,j));
 244   
 245  eqpf(h)..   sum(j, F(h,j)) =e= FF(h);
 246   
 247  * fictitious objective function
 248  obj..       UU     =e= prod(i, Xp(i)**alpha(i));
 249   
 250  * Initializing variables
 251  Y.l(j)    = Y0(j);
 252  F.l(h,j)  = F0(h,j);
 253  X.l(i,j)  = X0(i,j);
 254  Z.l(j)    = Z0(j);
 255  Xp.l(i)   = Xp0(i);
 256  Xg.l(i)   = Xg0(i);
 257  Xv.l(i)   = Xv0(i);
 258  E.l(i)    = E0(i);
 259  M.l(i)    = M0(i);
 260  Q.l(i)    = Q0(i);
 261  D.l(i)    = D0(i);
 262  pf.l(h)   = 1;
 263  py.l(j)   = 1;
 264  pz.l(j)   = 1;
 265  pq.l(i)   = 1;
 266  pe.l(i)   = 1;
 267  pm.l(i)   = 1;
 268  pd.l(i)   = 1;
 269  epsilon.l = 1;
 270  Sp.l      = Sp0;
 271  Sg.l      = Sg0;
 272  Td.l      = Td0;
 273  Tz.l(j)   = Tz0(j);
 274  Tm.l(i)   = Tm0(i);
 275   
 276  * Setting lower bounds to avoid division by zero
 277  Y.lo(j)    = 0.00001;
 278  F.lo(h,j)  = 0.00001;
 279  X.lo(i,j)  = 0.00001;
 280  Z.lo(j)    = 0.00001;
 281  Xp.lo(i)   = 0.00001;
 282  Xg.lo(i)   = 0.00001;
 283  Xv.lo(i)   = 0.00001;
 284  E.lo(i)    = 0.00001;
 285  M.lo(i)    = 0.00001;
 286  Q.lo(i)    = 0.00001;
 287  D.lo(i)    = 0.00001;
 288  pf.lo(h)   = 0.00001;
 289  py.lo(j)   = 0.00001;
 290  pz.lo(j)   = 0.00001;
 291  pq.lo(i)   = 0.00001;
 292  pe.lo(i)   = 0.00001;
 293  pm.lo(i)   = 0.00001;
 294  pd.lo(i)   = 0.00001;
 295  epsilon.lo = 0.00001;
 296  Sp.lo      = 0.00001;
 297  Sg.lo      = 0.00001;
 298  Td.lo      = 0.00001;
 299  Tz.lo(j)   = 0.0000;
 300  Tm.lo(i)   = 0.0000;
 301   
 302  * numeraire
 303  pf.fx("LAB") = 1;
 304   
 305  Model stdcge / all /;
 306   
 307  solve stdcge maximizing UU using nlp;
 308   
 309  * Simulación de 10% más de utilización de factores
 310  display FF;
 311  FF(h)   = 1.1 * FF(h);
 312  display FF;
 313   
 314  * ignore the basis and let the solver start from scratch.
 315  option bRatio = 1;
 316   
 317  solve stdcge maximizing UU using nlp;
 318   
 319  Parameter
 320      qq(i)
 321      fp(h);
 322  qq(i) = Xp.l(i)+Xg.l(i)+Xv.l(i)+sum(j,X.l(i,j));
 323  fp(h) = sum(i,F.l(h,i));
 324   
 325  display 'Escenario. Comprobación del equilibrio de mercado para el producto de Armington'
 326  display qq;
 327  display Q.l;
 328  display 'Escenario. Comprobación del equilibrio en los factores prestados y usados'
 329  display fp;
 330  display FF;
 331   
 332  * Simulation Runs: Abolition of Import Tariffs
 333  * restaurar los valores de FF
 334  FF(h)   = SAM("HOH",h);
 335   
 336  *Abolition of Import Tariffs
 337  taum(i) = 0;
 338   
 339  * ignore the basis and let the solver start from scratch.
 340  option bRatio = 1;
 341   
 342  solve stdcge maximizing UU using nlp;
