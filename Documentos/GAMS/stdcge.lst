 344  * List8.1: Display of changes
 345  Parameter
 346     dY(j), dF(h,j), dX(i,j), dZ(j),    dXp(i),     dXg(i), dXv(i)
 347     dE(i), dM(i),   dQ(i),   dD(i),    dpf(h),     dpy(j), dpz(i), dpq(i)
 348     dpe(i),dpm(i),  dpd(i),  depsilon, dTd,dTz(i), dTm(i), dSp,    dSg;
 349   
 350  dY(j)    = (Y.l(j)  /Y0(j)  -1)*100;
 351  dF(h,j)  = (F.l(h,j)/F0(h,j)-1)*100;
