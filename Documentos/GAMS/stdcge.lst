 353  dZ(j)    = (Z.l(j)  /Z0(j)  -1)*100;
 354  dXp(i)   = (Xp.l(i) /Xp0(i) -1)*100;
 355  dXg(i)   = (Xg.l(i) /Xg0(i) -1)*100;
 356  dXv(i)   = (Xv.l(i) /Xv0(i) -1)*100;
 357  dE(i)    = (E.l(i)  /E0(i)  -1)*100;
 358  dM(i)    = (M.l(i)  /M0(i)  -1)*100;
 359  dQ(i)    = (Q.l(i)  /Q0(i)  -1)*100;
 360  dD(i)    = (D.l(i)  /D0(i)  -1)*100;
 361  dpf(h)   = (pf.l(h) /1 -1)*100;
 362  dpy(j)   = (py.l(j) /1 -1)*100;
 363  dpz(j)   = (pz.l(j) /1 -1)*100;
 364  dpq(i)   = (pq.l(i) /1 -1)*100;
 365  dpe(i)   = (pe.l(i) /1 -1)*100;
 366  dpm(i)   = (pm.l(i) /1 -1)*100;
 367  dpd(i)   = (pd.l(i) /1 -1)*100;
 368  depsilon = (epsilon.l/1 -1)*100;
 369  dTd      = (Td.l    /Td0    -1)*100;
 370  dTz(j)   = (Tz.l(j) /Tz0(j) -1)*100;
 371  dTm(i)   = (Tm.l(i) /Tm0(i) -1)*100;
 372  dSp      = (Sp.l    /Sp0    -1)*100;
 373  dSg      = (Sg.l    /Sg0    -1)*100;
 374   
 375  display dY,  dF,  dX,  dZ,  dXp,      dXg, dXv, dE,  dM,  dQ, dD, dpf, dpy, dpz
 376          dpq, dpe, dpm, dpd, depsilon, dTd, dTz, dTm, dSp, dSg;
 377   
 378  * Welfare measure: Hicksian equivalent variations
 379  Parameter
 380     UU0 'utility level in the base run eq.'
 381     ep0 'expenditure func. in the base run eq.'
 382     ep1 'expenditure func. in the C-f eq.'
 383     EV  'Hicksian equivalent variations';
 384   
 385  UU0 = prod(i, Xp0(i)**alpha(i));
 386  ep0 = UU0 /prod(i, (alpha(i)/1)**alpha(i));
 387  ep1 = UU.l/prod(i, (alpha(i)/1)**alpha(i));
 388  EV  = ep1 - ep0;
 389   
 390  display EV;
